    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-xl font-bold tracking-tight text-light-text dark:text-white">Domain Management &amp; DKIM Key Specs</h3>
                <p class="text-xs text-light-muted dark:text-dark-muted">Konfigurasi nama domain email terlayani dan verifikasi kunci kriptografi RSA 2048-bit.</p>
            </div>
            <button onclick="openAddDomainModal()" class="px-4 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white transition-all flex items-center gap-1.5 shadow-cyan-glow">
                <i class="bi bi-plus-lg"></i> Tambah Domain
            </button>
        </div>

        <div class="p-5 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="text-[11px] uppercase tracking-wider text-light-muted dark:text-dark-muted border-b border-light-border dark:border-dark-border">
                    <tr>
                        <th class="py-3 px-3 font-semibold w-10 text-center">#</th>
                        <th class="py-3 px-4 font-semibold">Nama Domain</th>
                        <th class="py-3 px-4 font-semibold">DKIM Selector</th>
                        <th class="py-3 px-4 font-semibold">Key Spec</th>
                        <th class="py-3 px-4 font-semibold">Status</th>
                        <th class="py-3 px-4 font-semibold text-right">Tindakan</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-light-border dark:divide-dark-border">
                    <each items="domains" as="domain">
                        <tr class="hover:bg-slate-50 dark:hover:bg-dark-cardHover transition-colors">
                            <td class="py-3.5 px-3 font-mono text-center text-light-muted dark:text-dark-muted text-[11px]">{{ @count }}</td>
                            <td class="py-3.5 px-4 font-bold text-light-text dark:text-white">{{ domain.Name }}</td>
                            <td class="py-3.5 px-4 font-mono text-cyan-600 dark:text-cyan-400">{{ domain.DKIMSelector }}</td>
                            <td class="py-3.5 px-4 text-slate-500 dark:text-dark-muted">RSA 2048-bit</td>
                            <td class="py-3.5 px-4">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">ACTIVE</span>
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <button type="button" :data-domain="domain.Name" :data-selector="domain.DKIMSelector" :data-key="domain.DKIMPublicKey" onclick="openDkimFromBtn(this)" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-dark-bg border border-light-border dark:border-dark-border hover:border-cyan-500 text-light-text dark:text-slate-200 transition-colors cursor-pointer">
                                    <i class="bi bi-shield-lock text-cyan-500 me-1"></i> DNS TXT
                                </button>
                            </td>
                        </tr>
                    </each>
                    <if test="len(domains) == 0">
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-400">Belum ada domain terdaftar.</td>
                        </tr>
                    </if>
                </tbody>
            </table>
        </div>
    </div>

    <!-- MODAL TAMBAH DOMAIN -->
    <div id="modalAddDomain" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border rounded-2xl w-full max-w-md shadow-card-dark overflow-hidden flex flex-col">
            <div class="px-4 py-3 border-b border-light-border dark:border-dark-border flex items-center justify-between bg-light-header dark:bg-dark-header">
                <h3 class="text-sm font-bold text-light-text dark:text-white flex items-center gap-2">
                    <i class="bi bi-globe text-cyan-500"></i> Tambah Domain Baru
                </h3>
                <button type="button" onclick="closeAddDomainModal()" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white p-1">
                    <i class="bi bi-x-lg text-sm"></i>
                </button>
            </div>
            <div class="p-4 space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-light-muted dark:text-dark-muted mb-1">NAMA DOMAIN</label>
                    <input type="text" id="newDomainName" placeholder="example.com" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-dark-bg border border-light-border dark:border-dark-border text-light-text dark:text-white focus:outline-none focus:border-cyan-500" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-light-muted dark:text-dark-muted mb-1">DKIM SELECTOR (OPSIONAL)</label>
                    <input type="text" id="newDomainSelector" placeholder="default" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-dark-bg border border-light-border dark:border-dark-border text-light-text dark:text-white focus:outline-none focus:border-cyan-500" />
                </div>
            </div>
            <div class="px-4 py-3 border-t border-light-border dark:border-dark-border bg-light-header dark:bg-dark-header flex justify-end gap-2">
                <button onclick="closeAddDomainModal()" class="px-3 py-1.5 rounded-xl text-xs font-medium text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white border border-light-border dark:border-dark-border">Batal</button>
                <button onclick="submitCreateDomain()" class="px-4 py-1.5 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 shadow-cyan-glow">Simpan Domain</button>
            </div>
        </div>
    </div>

    <script>
        function openDkimFromBtn(btn) {
            const domainName = btn.getAttribute('data-domain') || '';
            const selector = btn.getAttribute('data-selector') || 'mail';
            const key = btn.getAttribute('data-key') || '';
            openDkimModal(domainName, selector, key);
        }

        function openAddDomainModal() {
            document.getElementById('modalAddDomain').classList.remove('hidden');
        }

        function closeAddDomainModal() {
            document.getElementById('modalAddDomain').classList.add('hidden');
        }

        async function submitCreateDomain() {
            const name = document.getElementById('newDomainName').value.trim();
            const selector = document.getElementById('newDomainSelector').value.trim() || 'default';
            if (!name) {
                showModalAlert({ title: 'Validasi Gagal', message: 'Nama domain wajib diisi.', type: 'warning' });
                return;
            }

            try {
                const res = await fetch('/api/v1/domains', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, dkim_selector: selector })
                });
                const data = await res.json();
                if (res.ok) {
                    closeAddDomainModal();
                    await showModalAlert({ title: 'Berhasil', message: `Domain ${name} berhasil ditambahkan beserta RSA 2048-bit DKIM Key!`, type: 'success' });
                    location.reload();
                } else {
                    showModalAlert({ title: 'Gagal', message: data.error || 'Gagal menambahkan domain.', type: 'error' });
                }
            } catch (err) {
                showModalAlert({ title: 'Kesalahan Jaringan', message: 'Gagal menghubungi server.', type: 'error' });
            }
        }

        window.openAddDomainModal = openAddDomainModal;
        window.closeAddDomainModal = closeAddDomainModal;
        window.openDkimFromBtn = openDkimFromBtn;
        window.submitCreateDomain = submitCreateDomain;
    </script>
