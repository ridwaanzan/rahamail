    <!-- Compiled Minified JavaScript Bundle (Bundled by Bun/Node) -->
    <script src="/static/js/app.min.js"></script>

    <script>
        let availablePresets = [];

        // Simple client-side tab switcher
        function switchTab(tabId) {
            const tabs = ['dashboard', 'domains', 'simulations', 'logs', 'settings'];
            tabs.forEach(t => {
                const el = document.getElementById('tab-' + t);
                const nav = document.getElementById('nav-' + t);
                if (el) el.classList.add('hidden');
                if (nav) {
                    nav.classList.remove('bg-cyan-500/10', 'text-cyan-600', 'dark:text-cyan-400', 'border', 'border-cyan-500/20', 'shadow-sm');
                    nav.classList.add('text-light-muted', 'dark:text-dark-muted');
                }
            });

            const activeEl = document.getElementById('tab-' + tabId);
            const activeNav = document.getElementById('nav-' + tabId);
            if (activeEl) activeEl.classList.remove('hidden');
            if (activeNav) {
                activeNav.classList.add('bg-cyan-500/10', 'text-cyan-600', 'dark:text-cyan-400', 'border', 'border-cyan-500/20', 'shadow-sm');
                activeNav.classList.remove('text-light-muted', 'dark:text-dark-muted');
            }

            const titles = {
                'dashboard': 'Welcome',
                'domains': 'Domain Management',
                'simulations': 'Spam & Phishing Awareness',
                'logs': 'SSE Live Stream',
                'settings': 'Server Settings'
            };
            document.getElementById('headerTitle').innerText = titles[tabId] || 'Welcome';

            if (tabId === 'simulations') {
                loadSimulations();
            }
        }

        async function loadSimulations() {
            try {
                const res = await fetch('/api/v1/admin/simulations');
                const data = await res.json();
                const tbody = document.getElementById('campaignsTableBody');
                if (!tbody) return;
                tbody.innerHTML = '';

                let grandTotalSent = 0;
                let grandTotalClicked = 0;
                let grandTotalReported = 0;

                if (!data.campaigns || data.campaigns.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-slate-400">Belum ada simulasi phishing yang dibuat. Klik "Buat Simulasi Baru" untuk memulai!</td></tr>';
                } else {
                    data.campaigns.forEach(c => {
                        grandTotalSent += c.total_sent || 0;
                        grandTotalClicked += c.total_clicked || 0;
                        grandTotalReported += c.total_reported || 0;

                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-slate-50 dark:hover:bg-dark-cardHover transition-colors';
                        const statusBadge = c.status === 'running' 
                            ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">RUNNING</span>'
                            : '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-500/10 text-slate-400 border border-slate-500/20">DRAFT</span>';

                        const clickPct = c.total_sent ? Math.round((c.total_clicked / c.total_sent) * 100) : 0;

                        tr.innerHTML = `
                            <td class="py-3 px-3">
                                <div class="font-bold text-light-text dark:text-white">${escapeHtml(c.title)}</div>
                                <div class="text-[10px] text-light-muted dark:text-dark-muted truncate max-w-xs">${escapeHtml(c.subject)}</div>
                            </td>
                            <td class="py-3 px-3 font-mono text-cyan-600 dark:text-cyan-400 text-[11px]">${escapeHtml(c.sender_email)}</td>
                            <td class="py-3 px-3">${statusBadge}</td>
                            <td class="py-3 px-3 text-light-muted dark:text-dark-muted">${c.total_sent || 0} org</td>
                            <td class="py-3 px-3">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-500 border border-rose-500/20">
                                    ${c.total_clicked || 0} (${clickPct}%)
                                </span>
                            </td>
                            <td class="py-3 px-3 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    <button onclick="viewCampaignDetail(${c.id})" class="px-2 py-1 rounded-lg text-xs font-semibold bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 hover:bg-cyan-500/20 transition-all flex items-center gap-1" title="Lihat Detail & Breakdown">
                                        <i class="bi bi-bar-chart text-[10px]"></i> Detail
                                    </button>
                                    ${c.status === 'draft' ? `
                                    <button onclick="launchCampaignNow(${c.id})" class="px-2.5 py-1 rounded-lg text-xs font-semibold text-white bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 shadow-sm flex items-center gap-1" title="Kirim/Luncurkan Email Simulasi Sekarang">
                                        <i class="bi bi-play-fill text-xs"></i> Kirim
                                    </button>` : ''}
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });

                    // Auto-load details of first campaign if available
                    if (data.campaigns.length > 0) {
                        viewCampaignDetail(data.campaigns[0].id);
                    }
                }

                document.getElementById('simStatTotalSent').innerText = grandTotalSent;
                document.getElementById('simStatTotalClicked').innerText = grandTotalClicked;
                document.getElementById('simStatTotalReported').innerText = grandTotalReported;
                document.getElementById('simStatFailureRate').innerText = grandTotalSent > 0 ? ((grandTotalClicked / grandTotalSent) * 100).toFixed(1) + '%' : '0.0%';

            } catch (err) {
                console.error('Failed to load simulations:', err);
            }
        }

        async function viewCampaignDetail(id) {
            try {
                const res = await fetch(`/api/v1/admin/simulations/${id}/stats`);
                const data = await res.json();
                if (!res.ok) return;

                document.getElementById('targetBreakdownTitle').innerHTML = `<i class="bi bi-person-lines-fill text-cyan-500"></i> Rincian Karyawan: <strong>${escapeHtml(data.title)}</strong>`;
                document.getElementById('badgeTargetCount').innerText = `${data.total_sent} Karyawan`;

                // Update Donut Chart
                const total = data.total_sent || 1;
                const lolosPct = Math.round((data.total_reported / total) * 100);
                const gagalPct = Math.round((data.total_clicked / total) * 100);

                const donutLolos = document.getElementById('donutSegmentLolos');
                const donutGagal = document.getElementById('donutSegmentGagal');
                if (donutLolos && donutGagal) {
                    donutLolos.setAttribute('stroke-dasharray', `${lolosPct} ${100 - lolosPct}`);
                    donutGagal.setAttribute('stroke-dasharray', `${gagalPct} ${100 - gagalPct}`);
                    donutGagal.setAttribute('stroke-dashoffset', `${-lolosPct}`);
                }
                document.getElementById('donutCenterRate').textContent = data.failure_rate;

                document.getElementById('lblLolos').innerText = data.total_reported;
                document.getElementById('lblGagal').innerText = data.total_clicked;
                document.getElementById('lblDiam').innerText = data.total_unresponsive;

                // Render Targets Table
                const tbody = document.getElementById('simTargetsTableBody');
                tbody.innerHTML = '';
                if (!data.targets || data.targets.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-light-muted dark:text-dark-muted">Belum ada target karyawan pada kampanye ini.</td></tr>';
                    return;
                }

                data.targets.forEach(t => {
                    const row = document.createElement('tr');
                    row.className = 'hover:bg-slate-50 dark:hover:bg-dark-cardHover transition-colors';
                    let statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-500/10 text-slate-400 border border-slate-500/20">Terkirim (Diam)</span>';
                    if (t.status === 'clicked') {
                        statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-500 border border-rose-500/20"><i class="bi bi-x-circle mr-1"></i>GAGAL (Klik Link)</span>';
                    } else if (t.status === 'reported') {
                        statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20"><i class="bi bi-check-circle mr-1"></i>LOLOS (Lapor Spam)</span>';
                    }

                    const clickedTime = t.clicked_at ? new Date(t.clicked_at).toLocaleString() : '-';
                    const ipAgent = t.ip_address ? `${t.ip_address} (${t.user_agent ? t.user_agent.substring(0, 24) + '...' : '-'})` : '-';

                    row.innerHTML = `
                        <td class="py-2.5 px-3 font-semibold text-light-text dark:text-white">${escapeHtml(t.user ? t.user.email : 'User #' + t.user_id)}</td>
                        <td class="py-2.5 px-3">${statusBadge}</td>
                        <td class="py-2.5 px-3 text-light-muted dark:text-dark-muted">${new Date(t.sent_at).toLocaleTimeString()}</td>
                        <td class="py-2.5 px-3 ${t.clicked_at ? 'text-rose-500 font-semibold' : 'text-light-muted dark:text-dark-muted'}">${clickedTime}</td>
                        <td class="py-2.5 px-3 text-[11px] font-mono text-light-muted dark:text-dark-muted">${escapeHtml(ipAgent)}</td>
                    `;
                    tbody.appendChild(row);
                });

            } catch (err) {
                console.error("Gagal memuat detail kampanye:", err);
            }
        }

        async function launchCampaignNow(id) {
            if (!confirm('Luncurkan email simulasi ini sekarang ke seluruh karyawan target?')) return;
            try {
                const res = await fetch(`/api/v1/admin/simulations/${id}/launch`, { method: 'POST' });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message);
                    loadSimulations();
                } else {
                    alert('Gagal meluncurkan: ' + (data.error || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Kesalahan jaringan: ' + err.message);
            }
        }

        async function openNewCampaignModal() {
            const modal = document.getElementById('modalNewCampaign');
            if (modal) modal.classList.remove('hidden');

            if (availablePresets.length === 0) {
                try {
                    const res = await fetch('/api/v1/admin/simulations/presets');
                    const data = await res.json();
                    availablePresets = data.presets || [];
                    const select = document.getElementById('simPresetSelect');
                    select.innerHTML = '<option value="">-- Pilih Skenario Phishing Siap Pakai --</option>';
                    availablePresets.forEach((p, idx) => {
                        select.innerHTML += `<option value="${idx}">${escapeHtml(p.title)}</option>`;
                    });
                } catch (e) {
                    console.error("Gagal load presets:", e);
                }
            }
        }

        function closeNewCampaignModal() {
            const modal = document.getElementById('modalNewCampaign');
            if (modal) modal.classList.add('hidden');
        }

        function onSelectPresetChange() {
            const idx = document.getElementById('simPresetSelect').value;
            if (idx === "") return;
            const preset = availablePresets[idx];
            if (!preset) return;

            document.getElementById('simCampaignTitle').value = preset.title;
            document.getElementById('simSenderName').value = preset.sender_name;
            document.getElementById('simSenderEmail').value = preset.sender_email;
            document.getElementById('simSubject').value = preset.subject;
            document.getElementById('simTemplateBody').value = preset.template_html;
        }

        async function submitNewCampaign() {
            const title = document.getElementById('simCampaignTitle').value.trim();
            const sender_name = document.getElementById('simSenderName').value.trim();
            const sender_email = document.getElementById('simSenderEmail').value.trim();
            const subject = document.getElementById('simSubject').value.trim();
            const template_body = document.getElementById('simTemplateBody').value.trim();

            if (!title || !sender_name || !sender_email || !subject || !template_body) {
                alert('Seluruh field form wajib diisi!');
                return;
            }

            const btn = document.getElementById('btnSubmitCampaign');
            btn.disabled = true;

            try {
                const res = await fetch('/api/v1/admin/simulations', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, sender_name, sender_email, subject, template_body })
                });
                const data = await res.json();
                if (res.ok) {
                    closeNewCampaignModal();
                    alert('Kampanye simulasi berhasil dibuat!');
                    loadSimulations();
                } else {
                    alert('Gagal: ' + (data.error || 'Terjadi kesalahan sistem'));
                }
            } catch (err) {
                alert('Kesalahan jaringan: ' + err.message);
            } finally {
                btn.disabled = false;
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
