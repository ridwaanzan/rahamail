<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .title }}</title>
    <!-- Compiled TailwindCSS Dark & Light Mode Theme -->
    <link rel="stylesheet" href="/static/css/app.min.css">
    <!-- Embedded Base64 Bootstrap Icons -->
    <link rel="stylesheet" href="/static/css/bootstrap-icons.min.css">
    <script>
        // Init theme immediately to prevent FOUC (flash of unstyled content)
        if (localStorage.getItem('theme') === 'light' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: light)').matches)) {
            document.documentElement.classList.remove('dark');
        } else {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body class="bg-light-bg dark:bg-dark-bg text-light-text dark:text-dark-text min-h-screen flex flex-col md:flex-row antialiased selection:bg-cyan-500 selection:text-white">

    <!-- 1. SIDEBAR NAVIGATION -->
    <aside class="w-full md:w-64 bg-light-sidebar dark:bg-dark-sidebar border-r border-light-border dark:border-dark-border flex flex-col justify-between shrink-0 min-h-screen p-4">
        <div>
            <!-- Corporate Brand / Logo Header -->
            <div class="flex items-center justify-between px-2 mb-8">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-cyan-glow">
                        <i class="bi bi-envelope-paper-heart-fill text-lg"></i>
                    </div>
                    <div>
                        <h1 class="text-base font-bold tracking-tight text-light-text dark:text-white">Corporate</h1>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-cyan-500/10 text-cyan-500 dark:text-cyan-400 border border-cyan-500/20">
                            {{ .db_driver }}
                        </span>
                    </div>
                </div>
                <button class="md:hidden text-slate-400 hover:text-white" onclick="toggleMobileSidebar()">
                    <i class="bi bi-x-lg text-lg"></i>
                </button>
            </div>

            <!-- Navigation Links -->
            <div class="px-2 mb-2">
                <span class="text-[11px] font-semibold tracking-wider uppercase text-light-muted dark:text-dark-muted">Active Menu</span>
            </div>
            <nav class="space-y-1.5" id="sidebarNav">
                <a href="#dashboard" onclick="switchTab('dashboard')" id="nav-dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 shadow-sm">
                    <i class="bi bi-grid-fill text-base"></i>
                    <span>Dashboard</span>
                </a>
                <a href="#domains" onclick="switchTab('domains')" id="nav-domains" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-globe text-base"></i>
                    <span>Domain Management</span>
                </a>
                <a href="/mail" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-inbox-fill text-base"></i>
                    <span>User Webmail</span>
                    <span class="ml-auto text-[10px] px-1.5 py-0.5 rounded-full bg-blue-500/10 text-blue-500 dark:text-blue-400 font-semibold border border-blue-500/20">Open</span>
                </a>
                <a href="#simulations" onclick="switchTab('simulations')" id="nav-simulations" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-shield-exclamation text-base"></i>
                    <span>Spam & Phishing</span>
                </a>
                <a href="#logs" onclick="switchTab('logs')" id="nav-logs" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-broadcast text-base"></i>
                    <span>Mail Server SSE Live</span>
                </a>
                <a href="#settings" onclick="switchTab('settings')" id="nav-settings" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-gear-fill text-base"></i>
                    <span>Settings & Backup</span>
                </a>
            </nav>
        </div>

        <!-- Sidebar Bottom Card / Watermark -->
        <div class="mt-8 pt-4 border-t border-light-border dark:border-dark-border px-2">
            <div class="p-3 rounded-xl bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border text-center">
                <div class="flex items-center justify-center gap-2 text-xs font-semibold text-light-muted dark:text-dark-muted">
                    <i class="bi bi-cpu-fill text-cyan-500"></i>
                    <span>Powered by Golang / SSE</span>
                </div>
                <div class="mt-1 text-[11px] text-slate-400">Zero Node.js Runtime</div>
            </div>
        </div>
    </aside>

    <!-- 2. MAIN CONTENT AREA -->
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
        <!-- TOPBAR NAVBAR -->
        <header class="h-16 bg-light-header dark:bg-dark-header border-b border-light-border dark:border-dark-border px-6 flex items-center justify-between shrink-0 sticky top-0 z-30">
            <!-- Welcome Header -->
            <div class="flex items-center gap-4">
                <div>
                    <h2 class="text-base font-bold text-light-text dark:text-white" id="headerTitle">Welcome</h2>
                </div>
            </div>

            <!-- Topbar Right Controls -->
            <div class="flex items-center gap-3.5">
                <!-- Quick Search Input -->
                <div class="relative hidden sm:block">
                    <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="globalSearchInput" placeholder="Search..." class="w-48 lg:w-64 pl-9 pr-4 py-1.5 text-xs rounded-full bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border text-light-text dark:text-dark-text focus:outline-none focus:border-cyan-500 transition-colors">
                </div>

                <!-- Theme Switcher Button (Dark / Light Mode) -->
                <button onclick="toggleTheme()" class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border text-light-muted dark:text-dark-muted hover:text-cyan-500 transition-colors" title="Toggle Dark/Light Mode">
                    <i class="bi bi-moon-stars-fill text-sm" id="themeIconDark"></i>
                    <i class="bi bi-sun-fill text-sm hidden text-amber-500" id="themeIconLight"></i>
                </button>

                <!-- Notifications Bell -->
                <div class="relative">
                    <button class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white transition-colors">
                        <i class="bi bi-bell-fill text-sm"></i>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-rose-500 ring-2 ring-white dark:ring-dark-card"></span>
                    </button>
                </div>

                <!-- User Profile Pill -->
                <div class="flex items-center gap-2.5 pl-2 border-l border-light-border dark:border-dark-border">
                    <div class="relative">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white text-xs font-bold">
                            AD
                        </div>
                        <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-dark-header"></span>
                    </div>
                    <div class="hidden sm:block text-left">
                        <div class="text-xs font-bold text-light-text dark:text-white">Admin</div>
                        <div class="text-[10px] text-light-muted dark:text-dark-muted">Super Administrator</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- CONTENT PANES WRAPPER -->
        <div class="p-6 space-y-6">

            <!-- TAB 1: DASHBOARD -->
            <section id="tab-dashboard" class="space-y-6">
                <!-- Dashboard Welcome Banner -->
                <div>
                    <h3 class="text-xl font-bold tracking-tight text-light-text dark:text-white">Admin Dashboard</h3>
                    <p class="text-xs text-light-muted dark:text-dark-muted">Corporate mail server management dashboard</p>
                </div>

                <!-- 4 KPI CARDS -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Card 1: Active Domains -->
                    <div class="p-4 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark flex flex-col justify-between">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-light-muted dark:text-dark-muted">Active Domains</span>
                            <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                        </div>
                        <div class="flex items-baseline justify-between mt-3">
                            <h4 class="text-3xl font-extrabold text-light-text dark:text-white" id="statDomains">{{ .stats.domains }}</h4>
                            <div class="w-24 h-9" id="sparklineDomains"></div>
                        </div>
                    </div>

                    <!-- Card 2: Total Mail Users -->
                    <div class="p-4 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark flex flex-col justify-between">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-light-muted dark:text-dark-muted">Total Mail Users</span>
                            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                        </div>
                        <div class="flex items-baseline justify-between mt-3">
                            <h4 class="text-3xl font-extrabold text-light-text dark:text-white" id="statUsers">{{ .stats.users }}</h4>
                            <div class="w-24 h-9" id="sparklineUsers"></div>
                        </div>
                    </div>

                    <!-- Card 3: Storage Used -->
                    <div class="p-4 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark flex flex-col justify-between">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-light-muted dark:text-dark-muted">Storage Used</span>
                            <span class="text-[11px] font-bold text-cyan-600 dark:text-cyan-400">1.2%</span>
                        </div>
                        <div class="mt-2">
                            <h4 class="text-2xl font-extrabold text-light-text dark:text-white">2.6 GB</h4>
                            <div class="w-full bg-slate-200 dark:bg-slate-800 h-2 rounded-full mt-2 overflow-hidden">
                                <div class="bg-gradient-to-r from-cyan-500 to-blue-500 h-full rounded-full" style="width: 12%"></div>
                            </div>
                            <div class="text-[10px] text-light-muted dark:text-dark-muted mt-1.5 flex justify-between">
                                <span>Used Storage</span>
                                <span>220 GB Quota</span>
                            </div>
                        </div>
                    </div>

                    <!-- Card 4: SSE Live Connection -->
                    <div class="p-4 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark flex flex-col justify-between">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-light-muted dark:text-dark-muted">SSE Live Status</span>
                            <div class="relative flex items-center justify-center">
                                <span id="ssePulseIndicator" class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
                                <span class="w-2 h-2 rounded-full bg-emerald-500 absolute"></span>
                            </div>
                        </div>
                        <div class="mt-2 text-center py-1">
                            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 text-xl font-bold animate-pulse-glow">
                                <i class="bi bi-activity"></i>
                            </div>
                            <div class="mt-1" id="sseStatusPill">
                                <span id="sseConnectionStatus" class="text-xs font-bold text-emerald-500">Connected</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MIDDLE SECTION: CHARTS -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Left: SSE Live Traffic Spline Chart -->
                    <div class="lg:col-span-2 p-5 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <h4 class="text-sm font-bold text-light-text dark:text-white">SSE Live Traffic</h4>
                                <p class="text-[11px] text-light-muted dark:text-dark-muted">Real-time traffic SSE driven events feed</p>
                            </div>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-cyan-500/10 text-cyan-500 border border-cyan-500/20">
                                <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span> Live Stream
                            </span>
                        </div>
                        <div class="h-48 w-full" id="sseTrafficChart"></div>
                        <div class="flex justify-between items-center text-[10px] text-light-muted dark:text-dark-muted mt-2 px-2 font-mono">
                            <span>12:00</span>
                            <span>14:00</span>
                            <span>16:00</span>
                            <span>18:00</span>
                            <span>20:00</span>
                            <span>Now</span>
                        </div>
                    </div>

                    <!-- Right: Spam Awareness Metrics -->
                    <div class="p-5 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark flex flex-col justify-between">
                        <div class="flex items-center justify-between mb-2">
                            <h4 class="text-sm font-bold text-light-text dark:text-white">Spam Awareness</h4>
                            <span class="text-xs text-light-muted dark:text-dark-muted"><i class="bi bi-shield-check text-cyan-500"></i></span>
                        </div>

                        <!-- Radial Donut Gauge -->
                        <div class="flex items-center justify-center py-2">
                            <div class="relative w-36 h-36 flex items-center justify-center">
                                <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                                    <path class="text-slate-200 dark:text-slate-800" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                    <path class="text-cyan-500" stroke-width="3.5" stroke-dasharray="35, 100" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                </svg>
                                <div class="absolute flex flex-col items-center">
                                    <span class="text-2xl font-black text-light-text dark:text-white">35%</span>
                                    <span class="text-[9px] uppercase tracking-wider text-light-muted dark:text-dark-muted">Vuln Rate</span>
                                </div>
                            </div>
                        </div>

                        <!-- Bar Legend -->
                        <div class="grid grid-cols-3 gap-2 text-center pt-2 border-t border-light-border dark:border-dark-border text-xs">
                            <div class="p-1.5 rounded-lg bg-rose-500/10 text-rose-500 font-semibold border border-rose-500/20">
                                <div>Spam</div>
                                <div class="text-sm font-bold">9</div>
                            </div>
                            <div class="p-1.5 rounded-lg bg-amber-500/10 text-amber-500 font-semibold border border-amber-500/20">
                                <div>Click</div>
                                <div class="text-sm font-bold">12</div>
                            </div>
                            <div class="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-500 font-semibold border border-emerald-500/20">
                                <div>Clean</div>
                                <div class="text-sm font-bold">88</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BOTTOM SECTION: RECENT LIVE LOGS TABLE -->
                <div class="p-5 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark">
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4">
                        <div>
                            <h4 class="text-sm font-bold text-light-text dark:text-white">Recent Live Logs</h4>
                            <p class="text-[11px] text-light-muted dark:text-dark-muted">Real-time incoming and outgoing mail transaction flow</p>
                        </div>
                        <div class="flex items-center gap-2 w-full sm:w-auto">
                            <input type="text" id="logFilterInput" placeholder="Filter email..." class="px-3 py-1.5 text-xs rounded-xl bg-slate-100 dark:bg-dark-bg border border-light-border dark:border-dark-border text-light-text dark:text-dark-text focus:outline-none focus:border-cyan-500 w-full sm:w-48">
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="text-[11px] uppercase tracking-wider text-light-muted dark:text-dark-muted border-b border-light-border dark:border-dark-border">
                                <tr>
                                    <th class="py-2.5 px-4 font-semibold">Time</th>
                                    <th class="py-2.5 px-4 font-semibold">Email</th>
                                    <th class="py-2.5 px-4 font-semibold">Subject / Info</th>
                                    <th class="py-2.5 px-4 font-semibold">Live-Status</th>
                                    <th class="py-2.5 px-4 font-semibold text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody id="liveLogsTableBody" class="divide-y divide-light-border dark:divide-dark-border">
                                {{ range .messages }}
                                <tr class="hover:bg-slate-50 dark:hover:bg-dark-cardHover transition-colors">
                                    <td class="py-3 px-4 text-slate-500 dark:text-dark-muted font-mono whitespace-nowrap">{{ .ReceivedAt.Format "15:04:05" }}</td>
                                    <td class="py-3 px-4 font-medium text-light-text dark:text-dark-text whitespace-nowrap">{{ .From }}</td>
                                    <td class="py-3 px-4 text-slate-500 dark:text-dark-muted truncate max-w-xs">{{ .Subject }}</td>
                                    <td class="py-3 px-4 whitespace-nowrap">
                                        {{ if eq .Mailbox "Spam" }}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-rose-500/10 text-rose-500 border border-rose-500/20">Blocked</span>
                                        {{ else }}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">Received</span>
                                        {{ end }}
                                    </td>
                                    <td class="py-3 px-4 text-right">
                                        <a href="/mail" class="text-cyan-500 hover:text-cyan-400 font-semibold"><i class="bi bi-eye"></i> View</a>
                                    </td>
                                </tr>
                                {{ else }}
                                <tr>
                                    <td colspan="5" class="py-8 text-center text-slate-400">Belum ada aktivitas email tercatat.</td>
                                </tr>
                                {{ end }}
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- TAB 2: DOMAIN MANAGEMENT -->
            <section id="tab-domains" class="hidden space-y-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-xl font-bold tracking-tight text-light-text dark:text-white">Domain Management & DKIM</h3>
                        <p class="text-xs text-light-muted dark:text-dark-muted">Konfigurasi nama domain email terlayani dan verifikasi kunci kriptografi RSA 2048-bit.</p>
                    </div>
                    <button onclick="document.getElementById('modalAddDomain').classList.remove('hidden')" class="px-4 py-2 rounded-xl text-xs font-semibold bg-cyan-500 hover:bg-cyan-600 text-white transition-colors flex items-center gap-1.5 shadow-cyan-glow">
                        <i class="bi bi-plus-lg"></i> Tambah Domain
                    </button>
                </div>

                <div class="p-5 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="text-[11px] uppercase tracking-wider text-light-muted dark:text-dark-muted border-b border-light-border dark:border-dark-border">
                            <tr>
                                <th class="py-3 px-4">Nama Domain</th>
                                <th class="py-3 px-4">DKIM Selector</th>
                                <th class="py-3 px-4">Key Spec</th>
                                <th class="py-3 px-4">Status</th>
                                <th class="py-3 px-4 text-right">Tindakan</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-light-border dark:divide-dark-border">
                            {{ range .domains }}
                            <tr class="hover:bg-slate-50 dark:hover:bg-dark-cardHover transition-colors">
                                <td class="py-3.5 px-4 font-bold text-light-text dark:text-white">{{ .Name }}</td>
                                <td class="py-3.5 px-4 font-mono text-cyan-600 dark:text-cyan-400">{{ .DKIMSelector }}</td>
                                <td class="py-3.5 px-4 text-slate-500 dark:text-dark-muted">RSA 2048-bit</td>
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">ACTIVE</span>
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <button class="px-3 py-1 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-dark-bg border border-light-border dark:border-dark-border hover:border-cyan-500 transition-colors">
                                        <i class="bi bi-key me-1"></i> DNS TXT
                                    </button>
                                </td>
                            </tr>
                            {{ end }}
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- TAB 3: PHISHING & SPAM AWARENESS -->
            <section id="tab-simulations" class="hidden space-y-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-xl font-bold tracking-tight text-light-text dark:text-white">Phishing & Spam Awareness Simulation</h3>
                        <p class="text-xs text-light-muted dark:text-dark-muted">Pelatihan keamanan siber karyawan terhadap social engineering dan deceptive links.</p>
                    </div>
                </div>

                <!-- Simulation Metrics Summary -->
                <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                    <div class="p-4 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border">
                        <span class="text-xs text-light-muted dark:text-dark-muted">Total Target Diuji</span>
                        <h4 class="text-2xl font-bold mt-1 text-light-text dark:text-white" id="simStatTotalSent">0</h4>
                    </div>
                    <div class="p-4 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border">
                        <span class="text-xs text-rose-500">Gagal (Klik Link)</span>
                        <h4 class="text-2xl font-bold mt-1 text-rose-500" id="simStatTotalClicked">0</h4>
                    </div>
                    <div class="p-4 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border">
                        <span class="text-xs text-emerald-500">Lolos (Lapor Spam)</span>
                        <h4 class="text-2xl font-bold mt-1 text-emerald-500" id="simStatTotalReported">0</h4>
                    </div>
                    <div class="p-4 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border">
                        <span class="text-xs text-cyan-500">Failure Rate</span>
                        <h4 class="text-2xl font-bold mt-1 text-cyan-500" id="simStatFailureRate">0.0%</h4>
                    </div>
                </div>

                <!-- Campaign List Table -->
                <div class="p-5 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="text-sm font-bold text-light-text dark:text-white">Daftar Kampanye Simulasi</h4>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="text-[11px] uppercase tracking-wider text-light-muted dark:text-dark-muted border-b border-light-border dark:border-dark-border">
                                <tr>
                                    <th class="py-2.5 px-4 font-semibold">Judul Kampanye</th>
                                    <th class="py-2.5 px-4 font-semibold">Pengirim Uji Coba</th>
                                    <th class="py-2.5 px-4 font-semibold">Status</th>
                                    <th class="py-2.5 px-4 font-semibold">Terkirim</th>
                                    <th class="py-2.5 px-4 font-semibold">Gagal (Klik)</th>
                                </tr>
                            </thead>
                            <tbody id="campaignsTableBody" class="divide-y divide-light-border dark:divide-dark-border">
                                <tr>
                                    <td colspan="5" class="py-6 text-center text-slate-400">Memuat kampanye...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- TAB 4: SSE LOGS FEED -->
            <section id="tab-logs" class="hidden space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-xl font-bold tracking-tight text-light-text dark:text-white">Real-time Server-Sent Events (SSE) Stream</h3>
                        <p class="text-xs text-light-muted dark:text-dark-muted">Koneksi stream log diagnostik langsung dari memori backend Golang.</p>
                    </div>
                    <button onclick="document.getElementById('sseTerminal').innerHTML = ''" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border hover:text-cyan-500 transition-colors">
                        <i class="bi bi-trash me-1"></i> Clear Logs
                    </button>
                </div>

                <div class="p-4 rounded-2xl bg-black font-mono text-xs text-emerald-400 h-96 overflow-y-auto space-y-1 border border-slate-800" id="sseTerminal">
                    <div class="text-slate-500">[*] Menginisialisasi koneksi EventSource ke /api/v1/sse...</div>
                </div>
            </section>

            <!-- TAB 5: SETTINGS & BACKUP -->
            <section id="tab-settings" class="hidden space-y-6">
                <div>
                    <h3 class="text-xl font-bold tracking-tight text-light-text dark:text-white">Server Settings & S3 Cloud Backup</h3>
                    <p class="text-xs text-light-muted dark:text-dark-muted">Pengaturan cadangan data otomatis dan enkripsi client-side AES-256 GCM.</p>
                </div>
                <div class="p-6 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border max-w-xl space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-light-muted dark:text-dark-muted mb-1.5">S3 BUCKET NAME</label>
                        <input type="text" id="s3Bucket" placeholder="my-corp-backups" class="w-full px-3.5 py-2 text-xs rounded-xl bg-slate-100 dark:bg-dark-bg border border-light-border dark:border-dark-border text-light-text dark:text-white focus:outline-none focus:border-cyan-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-light-muted dark:text-dark-muted mb-1.5">CLIENT-SIDE ENCRYPTION KEY (AES-256)</label>
                        <input type="password" id="s3Key" placeholder="••••••••••••••••" class="w-full px-3.5 py-2 text-xs rounded-xl bg-slate-100 dark:bg-dark-bg border border-light-border dark:border-dark-border text-light-text dark:text-white focus:outline-none focus:border-cyan-500">
                    </div>
                    <button class="px-5 py-2 rounded-xl text-xs font-semibold bg-cyan-500 hover:bg-cyan-600 text-white transition-colors shadow-cyan-glow">
                        <i class="bi bi-cloud-arrow-up-fill me-1.5"></i> Trigger Backup Now
                    </button>
                </div>
            </section>
        </div>
    </main>

    <!-- Compiled Minified JavaScript Bundle (Bundled by Bun/Node) -->
    <script src="/static/js/app.min.js"></script>

    <script>
        // Simple client-side tab switcher
        function switchTab(tabId) {
            const tabs = ['dashboard', 'domains', 'simulations', 'logs', 'settings'];
            tabs.forEach(t => {
                const el = document.getElementById('tab-' + t);
                const nav = document.getElementById('nav-' + t);
                if (el) el.classList.add('hidden');
                if (nav) {
                    nav.classList.remove('bg-cyan-500/10', 'text-cyan-600', 'dark:text-cyan-400', 'border', 'border-cyan-500/20', 'shadow-sm');
                    nav.classList.add('text-light-muted', 'dark:text-dark-muted');
                }
            });

            const activeEl = document.getElementById('tab-' + tabId);
            const activeNav = document.getElementById('nav-' + tabId);
            if (activeEl) activeEl.classList.remove('hidden');
            if (activeNav) {
                activeNav.classList.add('bg-cyan-500/10', 'text-cyan-600', 'dark:text-cyan-400', 'border', 'border-cyan-500/20', 'shadow-sm');
                activeNav.classList.remove('text-light-muted', 'dark:text-dark-muted');
            }

            const titles = {
                'dashboard': 'Welcome',
                'domains': 'Domain Management',
                'simulations': 'Spam & Phishing Awareness',
                'logs': 'SSE Live Stream',
                'settings': 'Server Settings'
            };
            document.getElementById('headerTitle').innerText = titles[tabId] || 'Welcome';

            if (tabId === 'simulations') {
                loadSimulations();
            }
        }

        async function loadSimulations() {
            try {
                const res = await fetch('/api/v1/admin/simulations');
                const data = await res.json();
                const tbody = document.getElementById('campaignsTableBody');
                if (!tbody) return;
                tbody.innerHTML = '';

                let totalSent = 0;
                let totalClicked = 0;
                let totalReported = 0;

                if (!data.campaigns || data.campaigns.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-slate-400">Belum ada simulasi phishing yang dibuat.</td></tr>';
                } else {
                    data.campaigns.forEach(c => {
                        totalSent += c.total_sent || 0;
                        totalClicked += c.total_clicked || 0;
                        totalReported += c.total_reported || 0;

                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-slate-50 dark:hover:bg-dark-cardHover transition-colors';
                        tr.innerHTML = `
                            <td class="py-3 px-4 font-bold text-light-text dark:text-white">${escapeHtml(c.title)}</td>
                            <td class="py-3 px-4 font-mono text-cyan-600 dark:text-cyan-400">${escapeHtml(c.sender_email)}</td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 rounded text-[10px] font-bold ${c.status === 'running' ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : 'bg-slate-500/10 text-slate-400 border border-slate-500/20'}">${c.status.toUpperCase()}</span></td>
                            <td class="py-3 px-4">${c.total_sent || 0} orang</td>
                            <td class="py-3 px-4 text-rose-500 font-semibold">${c.total_clicked || 0}</td>
                        `;
                        tbody.appendChild(tr);
                    });
                }

                document.getElementById('simStatTotalSent').innerText = totalSent;
                document.getElementById('simStatTotalClicked').innerText = totalClicked;
                document.getElementById('simStatTotalReported').innerText = totalReported;
                document.getElementById('simStatFailureRate').innerText = totalSent > 0 ? ((totalClicked / totalSent) * 100).toFixed(1) + '%' : '0.0%';

            } catch (err) {
                console.error('Failed to load simulations:', err);
            }
        }
    </script>
</body>
</html>
