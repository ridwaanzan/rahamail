<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .title }}</title>
    <link rel="stylesheet" href="/static/css/bootstrap.min.css">
    <link rel="stylesheet" href="/static/css/bootstrap-icons.min.css">
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            color: #0f172a;
        }
        .register-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1.25rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            width: 100%;
            max-width: 520px;
        }
        .brand-logo {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, #2563eb 0%, #38bdf8 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.25);
        }
    </style>
</head>
<body>
    <div class="container p-3">
        <div class="register-card p-4 p-md-5 mx-auto">
            <div class="text-center mb-4">
                <div class="brand-logo mx-auto mb-3 text-white">
                    <i class="bi bi-envelope-plus-fill fs-2"></i>
                </div>
                <h3 class="fw-bold mb-1 text-dark">Daftar Akun RaHaMail</h3>
                <p class="text-secondary small">Buat kotak surat (mailbox) pribadi baru dalam hitungan detik</p>
            </div>

            <div id="alertBox" class="alert d-none py-2 px-3 small" role="alert"></div>

            <form id="registerForm" onsubmit="handleRegister(event)">
                <!-- Username & Domain Selector -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Alamat Email Baru</label>
                    <div class="input-group">
                        <input type="text" id="username" class="form-control" placeholder="namauser" required autocomplete="username" onkeyup="debounceCheckUsername()">
                        <span class="input-group-text bg-light text-secondary border-end-0">@</span>
                        <select id="domainId" class="form-select border-start-0" onchange="checkUsernameAvailability()">
                            {{ range .domains }}
                            <option value="{{ .ID }}" data-name="{{ .Name }}">{{ .Name }}</option>
                            {{ end }}
                        </select>
                    </div>
                    <div id="usernameFeedback" class="small mt-1 text-secondary">
                        <i class="bi bi-info-circle me-1"></i>Hanya huruf (a-z), angka (0-9), titik, dan tanda minus.
                    </div>
                </div>

                <!-- Password -->
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Kata Sandi</label>
                        <input type="password" id="password" class="form-control" placeholder="••••••••" required minlength="6" autocomplete="new-password">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Ulangi Sandi</label>
                        <input type="password" id="confirmPassword" class="form-control" placeholder="••••••••" required minlength="6" autocomplete="new-password">
                    </div>
                </div>

                <!-- Anti-Spam Captcha Challenge (Pure-Go) -->
                <div class="mb-4 p-3 rounded-3 bg-light border">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="form-label small fw-semibold text-primary mb-0">
                            <i class="bi bi-shield-check me-1"></i>Tantangan Keamanan (Anti-Bot)
                        </label>
                        <span class="badge bg-secondary-subtle text-secondary small">Pure-Go</span>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-white fw-bold small text-dark" id="captchaText">{{ .captcha_q }}</span>
                        <input type="number" id="captchaAnswer" class="form-control" placeholder="Jawaban angka" required>
                    </div>
                    <input type="hidden" id="captchaToken" value="{{ .captcha_token }}">
                </div>

                <button type="submit" id="btnSubmit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm d-flex align-items-center justify-content-center">
                    <i class="bi bi-person-check-fill me-2"></i>Daftar Sekarang
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top">
                <p class="small text-secondary mb-0">
                    Sudah memiliki akun email? <a href="/login" class="text-primary text-decoration-none fw-semibold">Masuk ke Webmail</a>
                </p>
                <p class="small text-secondary mt-2 mb-0">
                    <a href="/" class="text-secondary text-decoration-none opacity-75"><i class="bi bi-speedometer2 me-1"></i>Kembali ke Dashboard Admin</a>
                </p>
            </div>
        </div>
    </div>

    <script src="/static/js/bootstrap.bundle.min.js"></script>
    <script>
        let checkTimeout = null;

        function debounceCheckUsername() {
            clearTimeout(checkTimeout);
            checkTimeout = setTimeout(checkUsernameAvailability, 400);
        }

        async function checkUsernameAvailability() {
            const username = document.getElementById('username').value.trim();
            const domainSelect = document.getElementById('domainId');
            const domainName = domainSelect.options[domainSelect.selectedIndex]?.getAttribute('data-name');
            const feedback = document.getElementById('usernameFeedback');

            if (!username) {
                feedback.className = 'small mt-1 text-secondary';
                feedback.innerHTML = '<i class="bi bi-info-circle me-1"></i>Hanya huruf (a-z), angka (0-9), titik, dan tanda minus.';
                return;
            }

            try {
                const res = await fetch(`/api/v1/auth/check-username?username=${encodeURIComponent(username)}&domain=${encodeURIComponent(domainName)}`);
                const data = await res.json();
                if (data.available) {
                    feedback.className = 'small mt-1 text-success fw-medium';
                    feedback.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i>${username}@${domainName} ${data.message}`;
                } else {
                    feedback.className = 'small mt-1 text-danger fw-medium';
                    feedback.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i>${data.message}`;
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function handleRegister(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmit');
            const alertBox = document.getElementById('alertBox');
            
            const username = document.getElementById('username').value.trim();
            const domainId = parseInt(document.getElementById('domainId').value);
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const captchaAnswer = document.getElementById('captchaAnswer').value.trim();
            const captchaToken = document.getElementById('captchaToken').value;

            if (password !== confirmPassword) {
                showAlert('danger', 'Konfirmasi kata sandi tidak cocok.');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Mendaftarkan...';

            try {
                const res = await fetch('/api/v1/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        username,
                        domain_id: domainId,
                        password,
                        confirm_password: confirmPassword,
                        captcha_token: captchaToken,
                        captcha_answer: captchaAnswer
                    })
                });

                const data = await res.json();
                if (res.ok && data.status === 'success') {
                    showAlert('success', data.message);
                    setTimeout(() => {
                        window.location.href = data.redirect || '/mail';
                    }, 1200);
                } else {
                    showAlert('danger', data.error || 'Terjadi kesalahan saat pendaftaran.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-person-check-fill me-2"></i>Daftar Sekarang';
                }
            } catch (err) {
                showAlert('danger', 'Gagal terhubung ke server.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-person-check-fill me-2"></i>Daftar Sekarang';
            }
        }

        function showAlert(type, msg) {
            const alertBox = document.getElementById('alertBox');
            alertBox.className = `alert alert-${type} py-2 px-3 small`;
            alertBox.textContent = msg;
            alertBox.classList.remove('d-none');
        }
    </script>
</body>
</html>
