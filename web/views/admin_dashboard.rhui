  <!-- TOP 4 KPI CARDS -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Card 1: Active Domains -->
    <ui:StatsCard 
      title="Active Domains" 
      :value="stats.domains" 
      subtitle="Terhubung ke Inbound MX" 
      badge="Verified" 
      icon="bi bi-globe" />

    <!-- Card 2: Total Mail Users -->
    <ui:StatsCard 
      title="Total Mail Users" 
      :value="stats.users" 
      subtitle="Akun Mailbox Aktif" 
      badge="Active" 
      icon="bi bi-people-fill" />

    <!-- Card 3: Storage Quota -->
    <ui:StatsCard 
      title="Storage Usage" 
      value="2.6 GB" 
      subtitle="Kapasitas dari 220 GB" 
      badge="1.2%" 
      icon="bi bi-hdd-network" />

    <!-- Card 4: SSE Live Status -->
    <ui:StatsCard 
      title="SSE Live Status" 
      value="Connected" 
      value_id="sseStatusText"
      subtitle="Event Stream Real-time" 
      badge="Live" 
      badge_id="sseStatusBadge"
      icon="bi bi-activity" />
  </div>

  <!-- MIDDLE SECTION: CHARTS -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left: SSE Live Traffic Visual -->
    <div class="lg:col-span-2 p-5 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h4 class="text-sm font-bold text-light-text dark:text-white">SSE Live Traffic</h4>
          <p class="text-[11px] text-light-muted dark:text-dark-muted">Real-time traffic SSE driven events feed</p>
        </div>
        <span id="sseStreamBadge" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
          <span id="sseStreamDot" class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="sseStreamText">Live Stream</span>
        </span>
      </div>
      <div class="h-48 w-full flex items-center justify-center border border-dashed border-light-border dark:border-dark-border rounded-xl bg-slate-50 dark:bg-dark-bg/50">
        <div class="text-center">
          <div id="ssePulseIcon" class="w-10 h-10 rounded-full bg-cyan-500/10 text-cyan-500 flex items-center justify-center mx-auto mb-2 text-base transition-colors">
            <i class="bi bi-activity"></i>
          </div>
          <span id="sseTelemetryStatus" class="text-xs font-semibold text-light-muted dark:text-dark-muted">Streaming SSE Diagnostic Telemetry...</span>
        </div>
      </div>
    </div>

    <!-- Right: Quick Server Health Metrics -->
    <div class="p-5 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-sm flex flex-col justify-between">
      <div>
        <h4 class="text-sm font-bold text-light-text dark:text-white mb-1">Server Engine Status</h4>
        <p class="text-[11px] text-light-muted dark:text-dark-muted mb-4">Diagnostic status daemon internal</p>

        <div class="space-y-3">
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-dark-bg border border-light-border dark:border-dark-border">
            <div class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-medium text-light-text dark:text-white">SMTP Inbound Daemon</span>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-semibold">:25 / :587</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-dark-bg border border-light-border dark:border-dark-border">
            <div class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-medium text-light-text dark:text-white">IMAP4rev1 Storage Engine</span>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-semibold">:143 / :993</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-dark-bg border border-light-border dark:border-dark-border">
            <div class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-medium text-light-text dark:text-white">TLS / ClamAV Antivirus</span>
            </div>
            <span class="text-[10px] font-semibold text-emerald-500">ARMED</span>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-light-border dark:border-dark-border mt-4 flex items-center justify-between text-xs text-light-muted dark:text-dark-muted">
        <span>Engine Platform</span>
        <span class="font-bold text-light-text dark:text-white">Golang 1.26 Pure Binary</span>
      </div>
    </div>
  </div>

  <!-- BOTTOM SECTION: RECENT INBOUND / OUTBOUND EMAILS -->
  <div class="p-5 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h4 class="text-sm font-bold text-light-text dark:text-white">Live Email Ingestion Feed</h4>
        <p class="text-[11px] text-light-muted dark:text-dark-muted">20 aktivitas surat elektronik inbound &amp; outbound terakhir</p>
      </div>
      <a href="/mail" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 hover:bg-cyan-500 hover:text-white transition-all border border-cyan-500/20 flex items-center gap-1.5">
        <span>Buka Webmail</span>
        <i class="bi bi-arrow-right"></i>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="text-[11px] uppercase tracking-wider text-light-muted dark:text-dark-muted border-b border-light-border dark:border-dark-border">
          <tr>
            <th class="py-3 px-4 font-semibold">Waktu</th>
            <th class="py-3 px-4 font-semibold">Pengirim (From)</th>
            <th class="py-3 px-4 font-semibold">Penerima (To)</th>
            <th class="py-3 px-4 font-semibold">Subjek</th>
            <th class="py-3 px-4 font-semibold">Security (SPF/DKIM)</th>
            <th class="py-3 px-4 font-semibold text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="inboundEmailTableBody" class="divide-y divide-light-border dark:divide-dark-border">
          <each items="messages" as="msg">
            <tr class="hover:bg-slate-50 dark:hover:bg-dark-cardHover transition-colors">
              <td class="py-3 px-4 text-light-muted dark:text-dark-muted font-mono">{{ msg.ReceivedAt | dateFormat("15:04:05") }}</td>
              <td class="py-3 px-4 font-medium text-light-text dark:text-white">{{ msg.From }}</td>
              <td class="py-3 px-4 text-light-muted dark:text-dark-muted">{{ msg.To }}</td>
              <td class="py-3 px-4 text-light-text dark:text-slate-200 truncate max-w-xs">{{ msg.Subject }}</td>
              <td class="py-3 px-4">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">PASS</span>
              </td>
              <td class="py-3 px-4 text-right">
                <a href="/mail" class="text-cyan-500 hover:text-cyan-400 font-semibold"><i class="bi bi-eye"></i> View</a>
              </td>
            </tr>
          </each>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    // Live SSE Connection Handler for Admin Dashboard
    (function initDashboardSSE() {
      const sseStatusText = document.getElementById('sseStatusText');
      const sseStatusBadge = document.getElementById('sseStatusBadge');
      const sseStreamBadge = document.getElementById('sseStreamBadge');
      const sseStreamDot = document.getElementById('sseStreamDot');
      const sseStreamText = document.getElementById('sseStreamText');
      const sseTelemetryStatus = document.getElementById('sseTelemetryStatus');

      function setConnectedState() {
        if (sseStatusText) sseStatusText.textContent = 'Connected';
        if (sseStatusBadge) {
          sseStatusBadge.textContent = 'Live';
          sseStatusBadge.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20';
        }
        if (sseStreamBadge) {
          sseStreamBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20';
        }
        if (sseStreamDot) {
          sseStreamDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse';
        }
        if (sseStreamText) sseStreamText.textContent = 'Live Stream';
        if (sseTelemetryStatus) sseTelemetryStatus.textContent = 'Receiving Real-time SSE Telemetry...';
      }

      function setDisconnectedState() {
        if (sseStatusText) sseStatusText.textContent = 'Offline';
        if (sseStatusBadge) {
          sseStatusBadge.textContent = 'Offline';
          sseStatusBadge.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-500 border border-rose-500/20';
        }
        if (sseStreamBadge) {
          sseStreamBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-rose-500/10 text-rose-500 border border-rose-500/20';
        }
        if (sseStreamDot) {
          sseStreamDot.className = 'w-1.5 h-1.5 rounded-full bg-rose-500';
        }
        if (sseStreamText) sseStreamText.textContent = 'Disconnected';
        if (sseTelemetryStatus) sseTelemetryStatus.textContent = 'Reconnecting to SSE Server...';
      }

      try {
        const sse = new EventSource('/api/v1/sse');
        sse.onopen = function() {
          setConnectedState();
        };
        sse.onerror = function() {
          setDisconnectedState();
        };
        sse.onmessage = function(event) {
          setConnectedState();
          try {
            const data = JSON.parse(event.data);
            if (data.type === 'stats' && data.payload) {
              // Update live stats if available
            }
          } catch(e) {}
        };
      } catch (err) {
        setDisconnectedState();
      }
    })();
  </script>
