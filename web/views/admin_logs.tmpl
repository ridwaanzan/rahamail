<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .title }}</title>
    <!-- Compiled TailwindCSS Dark & Light Mode Theme -->
    <link rel="stylesheet" href="/static/css/app.min.css">
    <!-- Embedded Base64 Bootstrap Icons -->
    <link rel="stylesheet" href="/static/css/bootstrap-icons.min.css">
    <script>
        if (localStorage.getItem('theme') === 'light' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: light)').matches)) {
            document.documentElement.classList.remove('dark');
        } else {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body class="bg-light-bg dark:bg-dark-bg text-light-text dark:text-dark-text min-h-screen flex flex-col md:flex-row antialiased selection:bg-cyan-500 selection:text-white">

    <!-- SIDEBAR NAVIGATION -->
    <aside class="w-full md:w-64 bg-light-sidebar dark:bg-dark-sidebar border-r border-light-border dark:border-dark-border flex flex-col justify-between shrink-0 min-h-screen p-4">
        <div>
            <!-- Brand / Logo Header -->
            <div class="flex items-center justify-between px-2 mb-8">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-cyan-glow">
                        <i class="bi bi-envelope-paper-heart-fill text-lg"></i>
                    </div>
                    <div>
                        <h1 class="text-base font-bold tracking-tight text-light-text dark:text-white">Corporate</h1>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-cyan-500/10 text-cyan-500 dark:text-cyan-400 border border-cyan-500/20">
                            {{ .db_driver }}
                        </span>
                    </div>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="px-2 mb-2">
                <span class="text-[11px] font-semibold tracking-wider uppercase text-light-muted dark:text-dark-muted">Admin Menu</span>
            </div>
            <nav class="space-y-1.5">
                <a href="/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-grid-fill text-base"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/domains" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-globe text-base"></i>
                    <span>Domain Management</span>
                </a>
                <a href="/mail" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-inbox-fill text-base"></i>
                    <span>User Webmail</span>
                    <span class="ml-auto text-[10px] px-1.5 py-0.5 rounded-full bg-blue-500/10 text-blue-500 dark:text-blue-400 font-semibold border border-blue-500/20">Open</span>
                </a>
                <a href="/admin/simulations" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-shield-exclamation text-base"></i>
                    <span>Spam & Phishing</span>
                </a>
                <a href="/admin/logs" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 shadow-sm">
                    <i class="bi bi-broadcast text-base"></i>
                    <span>Mail Server SSE Live</span>
                </a>
                <a href="/admin/settings" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-gear-fill text-base"></i>
                    <span>Settings & Backup</span>
                </a>
            </nav>
        </div>

        <div class="mt-8 pt-4 border-t border-light-border dark:border-dark-border px-2">
            <div class="p-3 rounded-xl bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border text-center">
                <div class="flex items-center justify-center gap-2 text-xs font-semibold text-light-muted dark:text-dark-muted">
                    <i class="bi bi-cpu-fill text-cyan-500"></i>
                    <span>Powered by Golang / SSE</span>
                </div>
                <div class="mt-1 text-[11px] text-slate-400">Zero Node.js Runtime</div>
            </div>
        </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
        <!-- TOPBAR -->
        <header class="h-16 bg-light-header dark:bg-dark-header border-b border-light-border dark:border-dark-border px-6 flex items-center justify-between shrink-0 sticky top-0 z-30">
            <div>
                <h2 class="text-base font-bold text-light-text dark:text-white">Real-time SSE Stream Terminal</h2>
            </div>
            <div class="flex items-center gap-3.5">
                <button onclick="toggleTheme()" class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border text-light-muted dark:text-dark-muted hover:text-cyan-500 transition-colors" title="Toggle Dark/Light Mode">
                    <i class="bi bi-moon-stars-fill text-sm hidden dark:inline"></i>
                    <i class="bi bi-sun-fill text-sm inline dark:hidden text-amber-500"></i>
                </button>
                <div class="flex items-center gap-2.5 pl-2 border-l border-light-border dark:border-dark-border">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white text-xs font-bold">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="hidden sm:block text-left">
                        <div class="text-xs font-bold text-light-text dark:text-white truncate max-w-[140px]">{{ if .currentUser }}{{ .currentUser.Email }}{{ else }}Super Admin{{ end }}</div>
                        <div class="text-[10px] text-cyan-600 dark:text-cyan-400 font-medium">Super Administrator</div>
                    </div>
                    <a href="/logout" class="ml-1 p-2 rounded-xl text-light-muted dark:text-dark-muted hover:text-rose-500 dark:hover:text-rose-400 hover:bg-rose-500/10 transition-colors" title="Keluar / Logout">
                        <i class="bi bi-box-arrow-right text-base"></i>
                    </a>
                </div>
            </div>
        </header>

        <!-- CONTENT -->
        <div class="p-6 space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-bold tracking-tight text-light-text dark:text-white">Server-Sent Events (SSE) Live Feed</h3>
                    <p class="text-xs text-light-muted dark:text-dark-muted">Koneksi stream log diagnostik langsung dari memori backend Golang tanpa polling.</p>
                </div>
                <button onclick="document.getElementById('sseTerminal').innerHTML = ''" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border text-light-muted dark:text-dark-muted hover:text-cyan-500 transition-colors flex items-center gap-1.5">
                    <i class="bi bi-trash"></i> Bersihkan Log
                </button>
            </div>

            <div class="p-4 rounded-2xl bg-black font-mono text-xs text-emerald-400 h-[650px] overflow-y-auto space-y-1.5 border border-slate-800 shadow-2xl" id="sseTerminal">
                <div class="text-slate-500">[*] Menginisialisasi koneksi EventSource ke /api/v1/sse...</div>
            </div>
        </div>
    </main>

    <script src="/static/js/app.min.js"></script>
    <script>
        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        // Live Log Stream
        const sse = new EventSource('/api/v1/sse');
        sse.onopen = () => {
            appendLog('SYSTEM', 'Tersambung ke server SSE live stream', 'text-emerald-400');
        };
        sse.onerror = () => {
            appendLog('ERROR', 'Koneksi terputus atau reconnecting...', 'text-rose-400');
        };
        sse.onmessage = (e) => {
            try {
                const data = JSON.parse(e.data);
                appendLog(data.type || 'EVENT', JSON.stringify(data), 'text-cyan-400');
            } catch (err) {
                appendLog('RAW', e.data, 'text-slate-300');
            }
        };

        function appendLog(category, msg, color) {
            const terminal = document.getElementById('sseTerminal');
            if (!terminal) return;
            const time = new Date().toLocaleTimeString();
            const div = document.createElement('div');
            div.innerHTML = `<span class="text-slate-500">[${time}]</span> <span class="${color}">[${category}]</span> <span class="text-slate-200">${msg}</span>`;
            terminal.appendChild(div);
            terminal.scrollTop = terminal.scrollHeight;
        }
    </script>
</body>
</html>
