        function previewAttachment(idx) {
            const att = currentMailAttachments[idx];
            if (!att) return;

            document.getElementById('attachmentPreviewTitle').innerHTML = `
                <i class="bi bi-file-earmark-text text-cyan-500 mr-2"></i> ${att.file_name}
            `;

            const downloadBtn = document.getElementById('btnDownloadPreview');
            const dataUri = `data:${att.content_type || 'application/octet-stream'};base64,${att.data_base64}`;
            downloadBtn.href = dataUri;
            downloadBtn.download = att.file_name;

            const container = document.getElementById('attachmentPreviewContent');
            container.innerHTML = '';

            const ctype = (att.content_type || '').toLowerCase();
            const fname = (att.file_name || '').toLowerCase();

            if (ctype.startsWith('image/') || fname.endsWith('.png') || fname.endsWith('.jpg') || fname.endsWith('.jpeg') || fname.endsWith('.gif') || fname.endsWith('.webp')) {
                container.innerHTML = `<img src="${dataUri}" class="max-h-[70vh] mx-auto rounded-lg shadow-md object-contain">`;
            } else if (ctype === 'application/pdf' || fname.endsWith('.pdf')) {
                container.innerHTML = `<iframe src="${dataUri}" class="w-full h-[70vh] rounded-lg border-0"></iframe>`;
            } else if (ctype.startsWith('text/') || fname.endsWith('.txt') || fname.endsWith('.log') || fname.endsWith('.json') || fname.endsWith('.csv')) {
                try {
                    const textContent = atob(att.data_base64);
                    container.innerHTML = `<pre class="text-left bg-slate-100 dark:bg-dark-header p-4 rounded-xl border border-light-border dark:border-dark-border max-h-[70vh] overflow-auto whitespace-pre-wrap text-xs font-mono text-light-text dark:text-white">${escapeHtml(textContent)}</pre>`;
                } catch (e) {
                    container.innerHTML = `<div class="p-4 rounded-xl bg-amber-500/10 text-amber-500 text-xs">Tidak dapat menampilkan isi teks. Silakan unduh file.</div>`;
                }
            } else {
                container.innerHTML = `
                    <div class="py-12">
                        <i class="bi bi-file-earmark-arrow-down text-4xl text-light-muted dark:text-dark-muted block mb-3"></i>
                        <h4 class="text-sm font-semibold text-light-text dark:text-white mb-1">Format file ini tidak mendukung preview langsung</h4>
                        <p class="text-xs text-light-muted dark:text-dark-muted mb-4">Ukuran: ${(att.size / 1024).toFixed(1)} KB | Tipe: ${att.content_type || 'Binary'}</p>
                        <a href="${dataUri}" download="${att.file_name}" class="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-cyan-500 to-blue-600 inline-flex items-center gap-1.5 shadow-cyan-glow">
                            <i class="bi bi-download"></i> Unduh Berkas Sekarang
                        </a>
                    </div>
                `;
            }

            showModal('attachmentPreviewModal');
        }

        function downloadAttachment(idx) {
            const att = currentMailAttachments[idx];
            if (!att) return;
            const a = document.createElement('a');
            a.href = `data:${att.content_type || 'application/octet-stream'};base64,${att.data_base64}`;
            a.download = att.file_name;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        function renderSecurityBanner(alertData) {
            const banner = document.getElementById('securityAlertBanner');
            const icon = document.getElementById('securityAlertIcon');
            const title = document.getElementById('securityAlertTitle');
            const desc = document.getElementById('securityAlertDesc');
            const btnTrust = document.getElementById('btnTrustSender');

            if (!banner || !icon || !title || !desc || !btnTrust) return;

            if (!alertData || alertData.level === 'none') {
                banner.classList.add('hidden');
                return;
            }

            banner.className = 'mt-3 p-3 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-sm ';

            if (alertData.level === 'danger') {
                banner.classList.add('bg-rose-500/10', 'border-rose-500/30', 'text-rose-500');
                icon.innerHTML = '<i class="bi bi-shield-x text-rose-500"></i>';
                btnTrust.classList.add('hidden');
            } else if (alertData.level === 'warning') {
                banner.classList.add('bg-amber-500/10', 'border-amber-500/30', 'text-amber-500');
                icon.innerHTML = '<i class="bi bi-exclamation-triangle text-amber-500"></i>';
                btnTrust.classList.remove('hidden');
            } else {
                banner.classList.add('bg-cyan-500/10', 'border-cyan-500/30', 'text-cyan-500');
                icon.innerHTML = '<i class="bi bi-info-circle text-cyan-500"></i>';
                btnTrust.classList.remove('hidden');
            }

            title.textContent = alertData.title || 'Peringatan Keamanan';
            desc.textContent = alertData.description || 'Harap berhati-hati dalam berinteraksi dengan pesan ini.';
            banner.classList.remove('hidden');
        }

        function dismissSecurityBanner() {
            const banner = document.getElementById('securityAlertBanner');
            if (banner) banner.classList.add('hidden');
        }

        async function trustSenderQuickAction() {
            if (!currentSecurityAlert || !currentSecurityAlert.sender_email) {
                alert('Informasi pengirim tidak tersedia.');
                return;
            }

            const senderEmail = currentSecurityAlert.sender_email;
            const fromDisplay = document.getElementById('readMailFrom')?.textContent || senderEmail;
            
            let contactName = senderEmail.split('@')[0];
            const nameMatch = fromDisplay.match(/^([^<]+)<.+>$/);
            if (nameMatch) {
                contactName = nameMatch[1].trim().replace(/^["']|["']$/g, '');
            }

            try {
                const res = await fetch('/api/v1/webmail/contacts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: contactName,
                        email: senderEmail,
                        company: 'Trusted Sender',
                        notes: 'Ditandai terpercaya dari webmail reader'
                    })
                });
                const data = await res.json();
                if (res.ok) {
                    dismissSecurityBanner();
                    alert(`Alamat ${senderEmail} berhasil ditambahkan ke Kontak & ditandai Terpercaya!`);
                    if (typeof loadContactsList === 'function') loadContactsList();
                } else {
                    alert(data.error || 'Gagal menambahkan ke daftar kontak terpercaya.');
                }
            } catch (err) {
                alert('Gagal menghubungi server.');
            }
        }

        function escapeHtml(text) {
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

