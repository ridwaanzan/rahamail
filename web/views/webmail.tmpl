        function handleContactAutoComplete(input, targetSugId) {
            clearTimeout(autoHarvestTimeout);
            const val = input.value;
            const container = document.getElementById(targetSugId);
            const lastToken = val.split(',').pop().trim();

            if (!lastToken || lastToken.length < 1) {
                container.classList.add('hidden');
                container.innerHTML = '';
                return;
            }

            autoHarvestTimeout = setTimeout(async () => {
                try {
                    const res = await fetch('/api/v1/webmail/contacts?q=' + encodeURIComponent(lastToken));
                    const data = await res.json();
                    if (res.ok && Array.isArray(data) && data.length > 0) {
                        container.innerHTML = data.slice(0, 5).map(c => `
                            <button type="button" class="w-full text-left p-2 hover:bg-slate-100 dark:hover:bg-dark-header flex justify-between items-center transition-colors" onclick="selectAutoCompleteContact('${input.id}', '${targetSugId}', '${c.email}')">
                                <div>
                                    <div class="text-xs font-semibold text-light-text dark:text-white">${escapeHtml(c.name)}</div>
                                    <div class="text-[10px] text-light-muted dark:text-dark-muted">${escapeHtml(c.email)}</div>
                                </div>
                                <span class="text-[9px] px-1 rounded bg-cyan-500/10 text-cyan-500 border border-cyan-500/20">Kontak</span>
                            </button>
                        `).join('');
                        container.classList.remove('hidden');
                    } else {
                        container.classList.add('hidden');
                    }
                } catch (e) {
                    container.classList.add('hidden');
                }
            }, 150);
        }

        function selectAutoCompleteContact(inputId, targetSugId, email) {
            const input = document.getElementById(inputId);
            const parts = input.value.split(',');
            parts.pop();
            parts.push(' ' + email);
            input.value = parts.join(',').trim();
            if (input.value.startsWith(',')) input.value = input.value.substring(1).trim();
            document.getElementById(targetSugId).classList.add('hidden');
            input.focus();
        }

        // Vacation Auto-Responder JS
        async function loadAutoResponderData() {
            try {
                const res = await fetch('/api/v1/webmail/auto-responder');
                const data = await res.json();
                if (res.ok && data) {
                    document.getElementById('arEnabled').checked = data.enabled;
                    document.getElementById('arSubject').value = data.subject || '';
                    document.getElementById('arBodyText').value = data.body_text || '';
                    if (data.start_time) {
                        document.getElementById('arStartTime').value = new Date(data.start_time).toISOString().slice(0, 16);
                    }
                    if (data.end_time) {
                        document.getElementById('arEndTime').value = new Date(data.end_time).toISOString().slice(0, 16);
                    }
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function submitSaveAutoResponder() {
            const enabled = document.getElementById('arEnabled').checked;
            const subject = document.getElementById('arSubject').value.trim();
            const body_text = document.getElementById('arBodyText').value;
            const startVal = document.getElementById('arStartTime').value;
            const endVal = document.getElementById('arEndTime').value;

            const payload = {
                enabled,
                subject,
                body_text,
                start_time: startVal ? new Date(startVal).toISOString() : null,
                end_time: endVal ? new Date(endVal).toISOString() : null
            };

            try {
                const res = await fetch('/api/v1/webmail/auto-responder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (res.ok) {
                    alert('Pengaturan balasan liburan otomatis berhasil disimpan.');
                    closeAutoResponderModal();
                } else {
                    const data = await res.json();
                    alert(data.error || 'Gagal menyimpan.');
                }
            } catch (err) {
                alert('Gagal terhubung ke server.');
            }
        }

        // Canned Responses / Templates JS
        async function loadTemplatesDropdown() {
            const container = document.getElementById('cannedTemplatesDropdown');
            try {
                const res = await fetch('/api/v1/webmail/templates');
                const data = await res.json();
                if (res.ok && Array.isArray(data)) {
                    if (data.length === 0) {
                        container.innerHTML = `
                            <div class="p-2 text-xs text-light-muted dark:text-dark-muted">Belum ada template</div>
                            <div class="border-t border-light-border dark:border-dark-border my-1"></div>
                            <button type="button" onclick="toggleTemplatesDropdown(); openCannedModal()" class="w-full text-left p-2 text-xs font-semibold text-cyan-600 dark:text-cyan-400 hover:bg-slate-100 dark:hover:bg-dark-header">
                                <i class="bi bi-gear mr-1"></i> Kelola Template
                            </button>
                        `;
                        return;
                    }
                    container.innerHTML = data.map(t => `
                        <button type="button" onclick="insertCannedTemplate('${escapeHtml(t.content).replace(/'/g, "\\'")}')" class="w-full text-left p-2 text-xs text-light-text dark:text-white hover:bg-slate-100 dark:hover:bg-dark-header truncate">
                            ${escapeHtml(t.title)}
                        </button>
                    `).join('') + `
                        <div class="border-t border-light-border dark:border-dark-border my-1"></div>
                        <button type="button" onclick="toggleTemplatesDropdown(); openCannedModal()" class="w-full text-left p-2 text-xs font-semibold text-cyan-600 dark:text-cyan-400 hover:bg-slate-100 dark:hover:bg-dark-header">
                            <i class="bi bi-gear mr-1"></i> Kelola Template
                        </button>
                    `;
                }
            } catch (err) {
                container.innerHTML = '<div class="p-2 text-xs text-rose-500">Gagal memuat</div>';
            }
        }

        function insertCannedTemplate(content) {
            const editor = document.getElementById('composeEditor');
            editor.innerHTML += '<p>' + content.replace(/\n/g, '<br>') + '</p>';
            triggerAutoSave();
            document.getElementById('cannedDropdownMenu').classList.add('hidden');
        }

        async function loadCannedList() {
            const list = document.getElementById('cannedModalList');
            try {
                const res = await fetch('/api/v1/webmail/templates');
                const data = await res.json();
                if (res.ok && Array.isArray(data)) {
                    if (data.length === 0) {
                        list.innerHTML = '<div class="text-center text-xs text-light-muted dark:text-dark-muted py-3">Belum ada template dibuat.</div>';
                        return;
                    }
                    list.innerHTML = data.map(t => `
                        <div class="p-2.5 rounded-lg border border-light-border dark:border-dark-border bg-slate-50 dark:bg-dark-header flex justify-between items-center">
                            <div class="truncate pr-2">
                                <h6 class="text-xs font-bold text-light-text dark:text-white mb-0.5">${escapeHtml(t.title)}</h6>
                                <p class="text-[11px] text-light-muted dark:text-dark-muted truncate">${escapeHtml(t.content)}</p>
                            </div>
                            <button onclick="deleteCannedItem(${t.id})" class="p-1 text-rose-500 hover:text-rose-400 shrink-0"><i class="bi bi-trash"></i></button>
                        </div>
                    `).join('');
                }
            } catch (err) {
                list.innerHTML = '<div class="text-center text-xs text-rose-500 py-3">Gagal memuat.</div>';
            }
        }

        async function submitCreateTemplate() {
            const title = document.getElementById('newTemplateTitle').value.trim();
            const content = document.getElementById('newTemplateContent').value.trim();
            if (!title || !content) {
                alert('Judul dan isi template wajib diisi.');
                return;
            }

            try {
                const res = await fetch('/api/v1/webmail/templates', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, content })
                });
                if (res.ok) {
                    document.getElementById('newTemplateTitle').value = '';
                    document.getElementById('newTemplateContent').value = '';
                    loadCannedList();
                } else {
                    const data = await res.json();
                    alert(data.error || 'Gagal menyimpan template.');
                }
            } catch (err) {
                alert('Gagal terhubung ke server.');
            }
        }

        async function deleteCannedItem(id) {
            if (!confirm('Hapus template ini?')) return;
            try {
                const res = await fetch(`/api/v1/webmail/templates/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    loadCannedList();
                } else {
                    alert('Gagal menghapus template.');
                }
            } catch (err) {
                alert('Gagal terhubung ke server.');
            }
        }

        // Live Real-Time SSE Listener
        const sseSource = new EventSource('/api/v1/sse');
        sseSource.onmessage = function(event) {
            try {
                const data = JSON.parse(event.data);
                if (data.type === 'new_email') {
                    const badge = document.getElementById('inboxCountBadge');
                    if (badge) {
                        badge.textContent = parseInt(badge.textContent || 0) + 1;
                    }
                }
            } catch (err) {
                console.error(err);
            }
        };
    </script>
</body>
</html>
