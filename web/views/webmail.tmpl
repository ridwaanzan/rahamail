                        </div>
                    </div>

                    <h6 class="fw-bold small text-secondary mb-2">Daftar Template Tersimpan:</h6>
                    <div class="list-group list-group-flush border rounded" id="cannedModalList" style="max-height: 250px; overflow-y: auto;">
