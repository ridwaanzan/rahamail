        function previewAttachment(idx) {
            const att = currentMailAttachments[idx];
            if (!att) return;

            document.getElementById('attachmentPreviewTitle').innerHTML = `
                <i class="bi bi-file-earmark-text text-primary me-2"></i>${att.file_name}
            `;

            const downloadBtn = document.getElementById('btnDownloadPreview');
            const dataUri = `data:${att.content_type || 'application/octet-stream'};base64,${att.data_base64}`;
            downloadBtn.href = dataUri;
            downloadBtn.download = att.file_name;

            const container = document.getElementById('attachmentPreviewContent');
            container.innerHTML = '';

            const ctype = (att.content_type || '').toLowerCase();
            const fname = (att.file_name || '').toLowerCase();

            if (ctype.startsWith('image/') || fname.endsWith('.png') || fname.endsWith('.jpg') || fname.endsWith('.jpeg') || fname.endsWith('.gif') || fname.endsWith('.webp')) {
                // Image Preview
                container.innerHTML = `<img src="${dataUri}" class="img-fluid rounded shadow-sm" style="max-height: 70vh; object-fit: contain;">`;
            } else if (ctype === 'application/pdf' || fname.endsWith('.pdf')) {
                // PDF Preview
                container.innerHTML = `<iframe src="${dataUri}" style="width: 100%; height: 70vh; border: none; border-radius: 8px;"></iframe>`;
            } else if (ctype.startsWith('text/') || fname.endsWith('.txt') || fname.endsWith('.log') || fname.endsWith('.json') || fname.endsWith('.csv')) {
                // Text Preview
                try {
                    const textContent = atob(att.data_base64);
                    container.innerHTML = `<pre class="text-start bg-light p-3 border rounded" style="max-height: 70vh; overflow: auto; white-space: pre-wrap;">${escapeHtml(textContent)}</pre>`;
                } catch (e) {
                    container.innerHTML = `<div class="alert alert-warning">Tidak dapat menampilkan isi teks. Silakan unduh file.</div>`;
                }
            } else {
                // Binary File fallback
                container.innerHTML = `
                    <div class="py-5">
                        <i class="bi bi-file-earmark-arrow-down fs-1 text-secondary mb-3 d-block"></i>
                        <h5>Format file ini tidak mendukung live preview langsung</h5>
                        <p class="text-secondary small">Ukuran file: ${(att.size / 1024).toFixed(1)} KB | Tipe: ${att.content_type || 'Binary'}</p>
                        <a href="${dataUri}" download="${att.file_name}" class="btn btn-primary px-4 py-2 mt-2">
                            <i class="bi bi-download me-1"></i>Unduh Berkas Sekarang
                        </a>
                    </div>
                `;
            }

            attachmentPreviewModalInstance.show();
        }

        function downloadAttachment(idx) {
            const att = currentMailAttachments[idx];
            if (!att) return;
            const a = document.createElement('a');
            a.href = `data:${att.content_type || 'application/octet-stream'};base64,${att.data_base64}`;
            a.download = att.file_name;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        function escapeHtml(text) {
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

