<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .title }}</title>
    <!-- Compiled TailwindCSS Dark & Light Mode Theme -->
    <link rel="stylesheet" href="/static/css/app.min.css">
    <!-- Embedded Base64 Bootstrap Icons -->
    <link rel="stylesheet" href="/static/css/bootstrap-icons.min.css">
    <script>
        // Init theme immediately to prevent FOUC (flash of unstyled content)
        if (localStorage.getItem('theme') === 'light' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: light)').matches)) {
            document.documentElement.classList.remove('dark');
        } else {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body class="bg-light-bg dark:bg-dark-bg text-light-text dark:text-dark-text h-screen overflow-hidden flex flex-col antialiased selection:bg-cyan-500 selection:text-white">

    <!-- TOPBAR / GLOBAL HEADER -->
    <header class="h-14 bg-light-header dark:bg-dark-header border-b border-light-border dark:border-dark-border px-4 flex items-center justify-between shrink-0 z-20">
        <div class="flex items-center gap-3">
            <button class="md:hidden text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white p-1" onclick="toggleMobileSidebar()" title="Toggle Menu">
                <i class="bi bi-list text-xl"></i>
            </button>
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-cyan-glow">
                    <i class="bi bi-envelope-fill text-sm"></i>
                </div>
                <div class="leading-tight">
                    <span class="text-sm font-bold tracking-tight text-light-text dark:text-white">WebMail</span>
                    <span class="text-[10px] text-cyan-600 dark:text-cyan-400 font-medium ml-1">Client</span>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <!-- Theme Toggle Button -->
            <button onclick="toggleTheme()" class="p-2 rounded-lg text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card border border-light-border dark:border-dark-border transition-all" title="Ganti Tema (Dark/Light)">
                <i class="bi bi-moon-stars-fill hidden dark:inline text-sm text-cyan-400"></i>
                <i class="bi bi-sun-fill inline dark:hidden text-sm text-amber-500"></i>
            </button>

            {{ if .current_user.IsAdmin }}
            <!-- Admin Dashboard Link -->
            <a href="/" class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 hover:bg-cyan-500/20 transition-all">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
            </a>
            {{ end }}

            <!-- User Menu & Logout -->
            <div class="flex items-center gap-2 pl-2 border-l border-light-border dark:border-dark-border">
                <div class="w-7 h-7 rounded-full bg-slate-200 dark:bg-dark-card border border-light-border dark:border-dark-border flex items-center justify-center text-xs font-bold text-light-text dark:text-white">
                    {{ slice .current_user.Email 0 1 }}
                </div>
                <span class="text-xs font-medium text-light-text dark:text-slate-200 hidden md:inline truncate max-w-[150px]">{{ .current_user.Email }}</span>
                <button onclick="openSecuritySettingsModal()" class="p-1.5 text-light-muted dark:text-dark-muted hover:text-cyan-500 dark:hover:text-cyan-400 transition-colors" title="Keamanan Akun & 2FA / API Keys">
                    <i class="bi bi-shield-lock text-sm"></i>
                </button>
                <a href="/logout" class="p-1.5 text-light-muted dark:text-dark-muted hover:text-rose-500 transition-colors" title="Keluar">
                    <i class="bi bi-box-arrow-right text-sm"></i>
                </a>
            </div>
        </div>
    </header>

    <!-- 3-PANE APPLICATION BODY -->
    <div class="flex flex-1 overflow-hidden relative">

        <!-- PANE 1: FOLDERS & LABELS SIDEBAR -->
        <aside id="sidebarFolders" class="w-60 bg-light-sidebar dark:bg-dark-sidebar border-r border-light-border dark:border-dark-border flex flex-col justify-between shrink-0 p-3 z-10 transition-transform duration-300 md:translate-x-0 -translate-x-full absolute md:relative h-full">
            <div class="flex flex-col flex-1 overflow-y-auto space-y-4">
                <!-- Compose Button with Gradient -->
                <button onclick="openComposer()" class="w-full py-2.5 px-4 rounded-xl font-semibold text-xs text-white bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 shadow-cyan-glow transition-all flex items-center justify-center gap-2">
                    <i class="bi bi-plus-lg text-sm"></i>
                    <span>Tulis Email</span>
                </button>

                <!-- Folder Navigation -->
                <div>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-light-muted dark:text-dark-muted px-2 mb-1 block">Folders</span>
                    <nav class="space-y-1">
                        <a href="/mail?folder=INBOX" class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium transition-all {{ if eq .current_folder "INBOX" }}bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 font-semibold border border-cyan-500/20{{ else }}text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card{{ end }}">
                            <div class="flex items-center gap-2.5">
                                <i class="bi bi-inbox-fill text-sm"></i>
                                <span>Inbox</span>
                            </div>
                            {{ if gt .inbox_count 0 }}
                            <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold {{ if eq .current_folder "INBOX" }}bg-cyan-500 text-white{{ else }}bg-slate-200 dark:bg-dark-border text-light-muted dark:text-dark-muted{{ end }}" id="inboxCountBadge">{{ .inbox_count }}</span>
                            {{ end }}
                        </a>

                        <a href="/mail?folder=Sent" class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium transition-all {{ if eq .current_folder "Sent" }}bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 font-semibold border border-cyan-500/20{{ else }}text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card{{ end }}">
                            <div class="flex items-center gap-2.5">
                                <i class="bi bi-send-fill text-sm"></i>
                                <span>Sent</span>
                            </div>
                            {{ if gt .sent_count 0 }}
                            <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold {{ if eq .current_folder "Sent" }}bg-cyan-500 text-white{{ else }}bg-slate-200 dark:bg-dark-border text-light-muted dark:text-dark-muted{{ end }}">{{ .sent_count }}</span>
                            {{ end }}
                        </a>

                        <a href="/mail?folder=Scheduled" class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium transition-all {{ if eq .current_folder "Scheduled" }}bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 font-semibold border border-cyan-500/20{{ else }}text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card{{ end }}">
                            <div class="flex items-center gap-2.5">
                                <i class="bi bi-clock-history text-sm text-amber-500"></i>
                                <span>Scheduled</span>
                            </div>
                            {{ if gt .scheduled_count 0 }}
                            <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-500 border border-amber-500/30">{{ .scheduled_count }}</span>
                            {{ end }}
                        </a>

                        <a href="/mail?folder=Drafts" class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium transition-all {{ if eq .current_folder "Drafts" }}bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 font-semibold border border-cyan-500/20{{ else }}text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card{{ end }}">
                            <div class="flex items-center gap-2.5">
                                <i class="bi bi-file-earmark-text-fill text-sm"></i>
                                <span>Drafts</span>
                            </div>
                            {{ if gt .drafts_count 0 }}
                            <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold {{ if eq .current_folder "Drafts" }}bg-cyan-500 text-white{{ else }}bg-slate-200 dark:bg-dark-border text-light-muted dark:text-dark-muted{{ end }}">{{ .drafts_count }}</span>
                            {{ end }}
                        </a>

                        <a href="/mail?folder=Spam" class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium transition-all {{ if eq .current_folder "Spam" }}bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 font-semibold border border-cyan-500/20{{ else }}text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card{{ end }}">
                            <div class="flex items-center gap-2.5">
                                <i class="bi bi-shield-slash-fill text-sm text-rose-500"></i>
                                <span>Spam</span>
                            </div>
                            {{ if gt .spam_count 0 }}
                            <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/20 text-rose-500 border border-rose-500/30">{{ .spam_count }}</span>
                            {{ end }}
                        </a>

                        <a href="/mail?folder=Trash" class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium transition-all {{ if eq .current_folder "Trash" }}bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 font-semibold border border-cyan-500/20{{ else }}text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card{{ end }}">
                            <div class="flex items-center gap-2.5">
                                <i class="bi bi-trash-fill text-sm"></i>
                                <span>Trash</span>
                            </div>
                            {{ if gt .trash_count 0 }}
                            <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold {{ if eq .current_folder "Trash" }}bg-cyan-500 text-white{{ else }}bg-slate-200 dark:bg-dark-border text-light-muted dark:text-dark-muted{{ end }}">{{ .trash_count }}</span>
                            {{ end }}
                        </a>
                    </nav>
                </div>

                <!-- Custom Labels / Tags -->
                <div>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-light-muted dark:text-dark-muted px-2 mb-1 block">Quick Tools</span>
                    <nav class="space-y-1">
                        <a href="javascript:void(0)" onclick="openContactsModal()" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card transition-all">
                            <i class="bi bi-person-lines-fill text-cyan-500 text-sm"></i>
                            <span>Buku Kontak</span>
                        </a>
                        <a href="javascript:void(0)" onclick="openAutoResponderModal()" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card transition-all">
                            <i class="bi bi-calendar-event text-amber-500 text-sm"></i>
                            <span>Balasan Liburan</span>
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Sidebar Storage Quota & User Footer -->
            <div class="pt-3 border-t border-light-border dark:border-dark-border mt-auto">
                <div class="flex items-center justify-between text-[11px] text-light-muted dark:text-dark-muted mb-1.5">
                    <span class="flex items-center gap-1"><i class="bi bi-hdd-fill text-[10px]"></i> Storage</span>
                    <span>{{ .storage_used }}MB / {{ .storage_quota }}MB</span>
                </div>
                <div class="w-full bg-slate-200 dark:bg-dark-border rounded-full h-1.5 overflow-hidden">
                    <div class="bg-cyan-500 h-1.5 rounded-full" style="width: 2%"></div>
                </div>
            </div>
        </aside>

        <!-- PANE 2: MAILBOX MESSAGE LIST -->
        <section class="w-full md:w-80 lg:w-96 bg-light-card dark:bg-dark-sidebar border-r border-light-border dark:border-dark-border flex flex-col shrink-0">
            <!-- Search & Filter Header -->
            <div class="p-3 border-b border-light-border dark:border-dark-border space-y-2">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-light-text dark:text-white uppercase tracking-wider">
                            {{ if eq .current_folder "Scheduled" }}
                            <i class="bi bi-clock-history text-amber-500 mr-1"></i>Email Terjadwal
                            {{ else }}
                            {{ .current_folder }}
                            {{ end }}
                        </span>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 font-semibold border border-cyan-500/20">
                            {{ .total_items }}
                        </span>
                    </div>
                    <button onclick="location.reload()" class="p-1 text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white transition-colors" title="Segarkan">
                        <i class="bi bi-arrow-clockwise text-sm"></i>
                    </button>
                </div>

                <!-- Search Input Bar -->
                <div class="relative">
                    <i class="bi bi-search absolute left-3 top-2.5 text-light-muted dark:text-dark-muted text-xs"></i>
                    <input type="text" id="searchInput" placeholder="Cari pesan atau pengirim..." onkeyup="filterMessages()" class="w-full pl-8 pr-3 py-1.5 rounded-lg text-xs bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border text-light-text dark:text-white placeholder:text-light-muted dark:placeholder:text-dark-muted focus:outline-none focus:border-cyan-500 transition-colors">
                </div>
            </div>

            <!-- Mail Items List (Scrollable) -->
            <div class="flex-1 overflow-y-auto divide-y divide-light-border dark:divide-dark-border/60" id="mailListContainer">
                {{ if eq .current_folder "Scheduled" }}
                    <!-- List Email Terjadwal -->
                    {{ range .scheduled_mails }}
                    <div class="mail-item p-3 cursor-pointer hover:bg-slate-50 dark:hover:bg-dark-card/60 transition-colors" id="sched-item-{{ .ID }}">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-[11px] text-amber-500 font-semibold flex items-center gap-1">
                                <i class="bi bi-clock text-[10px]"></i>{{ .ScheduledAt.Format "02 Jan 15:04" }}
                            </span>
                            <span class="text-[10px] px-1.5 py-0.2 rounded font-medium {{ if eq .Status "pending" }}bg-amber-500/10 text-amber-500 border border-amber-500/20{{ else if eq .Status "sent" }}bg-emerald-500/10 text-emerald-500 border border-emerald-500/20{{ else }}bg-rose-500/10 text-rose-500 border border-rose-500/20{{ end }}">
                                {{ .Status }}
                            </span>
                        </div>
                        <h4 class="text-xs font-semibold text-light-text dark:text-white truncate mb-0.5">{{ .Subject }}</h4>
                        <p class="text-[11px] text-light-muted dark:text-dark-muted truncate">Kepada: {{ .To }}</p>
                        {{ if eq .Status "pending" }}
                        <div class="mt-2 text-right">
                            <button onclick="cancelSchedule({{ .ID }})" class="px-2 py-0.5 text-[10px] font-medium text-rose-500 hover:text-white hover:bg-rose-600 border border-rose-500/30 rounded transition-all">
                                <i class="bi bi-x-circle mr-1"></i>Batalkan
                            </button>
                        </div>
                        {{ end }}
                    </div>
                    {{ else }}
                    <div class="text-center py-12 px-4 text-light-muted dark:text-dark-muted">
                        <i class="bi bi-clock-history text-3xl opacity-30 block mb-2"></i>
                        <p class="text-xs">Tidak ada email yang sedang dijadwalkan.</p>
                    </div>
                    {{ end }}
                {{ else }}
                    <!-- List Email Reguler -->
                    {{ range .messages }}
                    <div class="mail-item p-3 cursor-pointer hover:bg-slate-50 dark:hover:bg-dark-card/60 transition-colors {{ if not .IsSeen }}border-l-2 border-cyan-500 bg-cyan-500/[0.02]{{ end }}" id="msg-item-{{ .ID }}" onclick="loadMessageDetail({{ .ID }})">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-semibold {{ if not .IsSeen }}text-cyan-600 dark:text-cyan-400{{ else }}text-light-text dark:text-slate-300{{ end }} truncate pr-2">
                                {{ .From }}
                            </span>
                            <span class="text-[10px] text-light-muted dark:text-dark-muted shrink-0">{{ .ReceivedAt.Format "02 Jan 15:04" }}</span>
                        </div>
                        <h4 class="text-xs {{ if not .IsSeen }}font-bold text-light-text dark:text-white{{ else }}font-medium text-slate-700 dark:text-slate-300{{ end }} truncate mb-1">
                            {{ .Subject }}
                        </h4>
                        <p class="text-[11px] text-light-muted dark:text-dark-muted truncate line-clamp-1 mb-2">
                            {{ .Snippet }}
                        </p>
                        <div class="flex items-center justify-between pt-1">
                            <div class="flex items-center gap-1.5">
                                <span class="text-[9px] px-1 py-0.2 rounded font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                                    SPF: {{ .SPFStatus }}
                                </span>
                                <span class="text-[9px] px-1 py-0.2 rounded font-mono bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">
                                    DKIM: {{ .DKIMStatus }}
                                </span>
                            </div>
                            <button onclick="toggleStar(event, {{ .ID }})" id="star-btn-{{ .ID }}" class="text-light-muted dark:text-dark-muted hover:text-amber-400 p-0.5" title="Bintang">
                                <i class="bi {{ if .IsFlagged }}bi-star-fill text-amber-400{{ else }}bi-star{{ end }} text-xs"></i>
                            </button>
                        </div>
                    </div>
                    {{ else }}
                    <div class="text-center py-12 px-4 text-light-muted dark:text-dark-muted">
                        <i class="bi bi-inbox text-3xl opacity-30 block mb-2"></i>
                        <p class="text-xs">Belum ada email di folder ini.</p>
                    </div>
                    {{ end }}
                {{ end }}
            </div>

            <!-- Pagination Footer -->
            <div class="p-2.5 px-3 border-t border-light-border dark:border-dark-border flex items-center justify-between text-[11px] text-light-muted dark:text-dark-muted bg-slate-50 dark:bg-dark-header">
                <span>{{ .start_item }}-{{ .end_item }} dari {{ .total_items }}</span>
                <div class="flex items-center gap-1">
                    {{ if .has_prev }}
                    <a href="/mail?folder={{ .current_folder }}&page={{ .prev_page }}&limit={{ .limit }}" class="p-1 rounded text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-200 dark:hover:bg-dark-card border border-light-border dark:border-dark-border" title="Sebelumnya">
                        <i class="bi bi-chevron-left text-xs"></i>
                    </a>
                    {{ else }}
                    <button disabled class="p-1 rounded opacity-30 text-light-muted dark:text-dark-muted border border-light-border dark:border-dark-border cursor-not-allowed">
                        <i class="bi bi-chevron-left text-xs"></i>
                    </button>
                    {{ end }}

                    {{ if .has_next }}
                    <a href="/mail?folder={{ .current_folder }}&page={{ .next_page }}&limit={{ .limit }}" class="p-1 rounded text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-200 dark:hover:bg-dark-card border border-light-border dark:border-dark-border" title="Berikutnya">
                        <i class="bi bi-chevron-right text-xs"></i>
                    </a>
                    {{ else }}
                    <button disabled class="p-1 rounded opacity-30 text-light-muted dark:text-dark-muted border border-light-border dark:border-dark-border cursor-not-allowed">
                        <i class="bi bi-chevron-right text-xs"></i>
                    </button>
                    {{ end }}
                </div>
            </div>
        </section>

        <!-- PANE 3: EMAIL DETAIL & READER PANE -->
        <main class="flex-1 bg-light-card dark:bg-dark-bg flex flex-col overflow-hidden">
            <!-- Empty State Placeholder -->
            <div id="readerEmptyState" class="h-full flex flex-col items-center justify-center text-center p-6 text-light-muted dark:text-dark-muted">
                <div class="w-16 h-16 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-500 dark:text-cyan-400 mb-4 shadow-cyan-glow">
                    <i class="bi bi-envelope-open text-2xl"></i>
                </div>
                <h3 class="text-sm font-semibold text-light-text dark:text-white mb-1">Pilih email di sebelah kiri untuk membaca</h3>
                <p class="text-xs max-w-sm">RaHaMail Sandboxed Reader Engine v1.4.1 dengan perlindungan anti-XSS & verifikasi SPF/DKIM.</p>
            </div>

            <!-- Active Reader Container -->
            <div id="readerContainer" class="hidden h-full flex flex-col overflow-hidden">
                <!-- Reader Action Toolbar -->
                <div class="p-3 border-b border-light-border dark:border-dark-border bg-light-header dark:bg-dark-header flex items-center justify-between shrink-0">
                    <div class="flex items-center gap-1.5">
                        <button onclick="replyCurrentMail()" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-light-text dark:text-white hover:bg-slate-100 dark:hover:bg-dark-card border border-light-border dark:border-dark-border transition-all flex items-center gap-1.5">
                            <i class="bi bi-reply-fill text-cyan-500"></i>
                            <span>Balas</span>
                        </button>
                        <button onclick="forwardCurrentMail()" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-light-text dark:text-white hover:bg-slate-100 dark:hover:bg-dark-card border border-light-border dark:border-dark-border transition-all flex items-center gap-1.5">
                            <i class="bi bi-forward-fill text-blue-500"></i>
                            <span>Teruskan</span>
                        </button>
                        <div class="h-4 w-px bg-light-border dark:bg-dark-border mx-1"></div>
                        <button onclick="moveCurrentMail('Spam')" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-amber-600 dark:text-amber-400 hover:bg-amber-500/10 border border-amber-500/20 transition-all flex items-center gap-1.5">
                            <i class="bi bi-shield-slash"></i>
                            <span>Spam</span>
                        </button>
                        <button onclick="moveCurrentMail('Trash')" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-500/10 border border-rose-500/20 transition-all flex items-center gap-1.5">
                            <i class="bi bi-trash"></i>
                            <span>Hapus</span>
                        </button>
                    </div>
                    <div>
                        <span id="readMailDate" class="text-xs text-light-muted dark:text-dark-muted font-medium"></span>
                    </div>
                </div>

                <!-- Email Header & Metadata -->
                <div class="p-4 border-b border-light-border dark:border-dark-border bg-light-card dark:bg-dark-sidebar shrink-0">
                    <div class="flex flex-col md:flex-row md:items-start justify-between gap-3">
                        <div class="space-y-1.5">
                            <h2 id="readMailSubject" class="text-base font-bold text-light-text dark:text-white tracking-tight"></h2>
                            <div class="flex flex-wrap items-center gap-2 text-xs">
                                <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">Dari:</span>
                                <span id="readMailFrom" class="font-medium text-light-text dark:text-slate-200"></span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2 text-xs">
                                <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-200 dark:bg-dark-card text-light-muted dark:text-dark-muted border border-light-border dark:border-dark-border">Kepada:</span>
                                <span id="readMailTo" class="text-light-muted dark:text-dark-muted"></span>
                            </div>
                        </div>

                        <!-- Auth Badges -->
                        <div class="flex items-center gap-1.5 self-start shrink-0">
                            <span id="spfBadge" class="text-[10px] px-2 py-0.5 rounded font-mono font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">SPF: PASS</span>
                            <span id="dkimBadge" class="text-[10px] px-2 py-0.5 rounded font-mono font-bold bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">DKIM: PASS</span>
                            <span id="dmarcBadge" class="text-[10px] px-2 py-0.5 rounded font-mono font-bold bg-slate-200 dark:bg-dark-card text-light-muted dark:text-dark-muted border border-light-border dark:border-dark-border">DMARC: PASS</span>
                        </div>
                    </div>

                    <!-- Attachment List Chips -->
                    <div id="attachmentArea" class="hidden mt-3 pt-3 border-t border-light-border dark:border-dark-border">
                        <span class="text-[11px] font-semibold text-light-muted dark:text-dark-muted block mb-2"><i class="bi bi-paperclip mr-1"></i>Lampiran File:</span>
                        <div id="attachmentList" class="flex flex-wrap gap-2"></div>
                    </div>

                    <!-- Security Alert Banner -->
                    <div id="securityAlertBanner" class="hidden mt-3 p-3 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-sm">
                        <div class="flex items-center gap-3">
                            <div id="securityAlertIcon" class="text-xl shrink-0"></div>
                            <div>
                                <h4 id="securityAlertTitle" class="text-xs font-bold mb-0.5"></h4>
                                <p id="securityAlertDesc" class="text-[11px] text-light-muted dark:text-dark-muted"></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <button type="button" id="btnTrustSender" onclick="trustSenderQuickAction()" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 hover:bg-emerald-500/20 transition-all flex items-center gap-1">
                                <i class="bi bi-person-check text-xs"></i>
                                <span>Tandai Terpercaya</span>
                            </button>
                            <button type="button" onclick="moveCurrentMail('Spam')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 hover:bg-rose-500/20 transition-all flex items-center gap-1">
                                <i class="bi bi-shield-slash text-xs"></i>
                                <span>Spam</span>
                            </button>
                            <button type="button" onclick="dismissSecurityBanner()" class="p-1 text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white">
                                <i class="bi bi-x-lg text-xs"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Sandboxed Body Viewer (Iframe or Plain Text) -->
                <div class="flex-1 p-4 overflow-hidden flex flex-col bg-slate-50 dark:bg-dark-bg">
                    <div id="textContentContainer" class="hidden h-full overflow-y-auto p-4 rounded-xl bg-white dark:bg-dark-card border border-light-border dark:border-dark-border text-xs font-mono whitespace-pre-wrap text-light-text dark:text-slate-200"></div>
                    <iframe id="htmlContentFrame" class="hidden w-full h-full rounded-xl bg-white border border-light-border dark:border-dark-border" sandbox="allow-same-origin"></iframe>
                </div>
            </div>
        </main>
    </div>

    <!-- MODAL 1: RICH-TEXT COMPOSER (TAILWIND REWRITE) -->
    <div id="composerModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border rounded-2xl w-full max-w-2xl shadow-card-dark overflow-hidden flex flex-col max-h-[90vh]">
            <!-- Modal Header -->
            <div class="px-4 py-3 border-b border-light-border dark:border-dark-border flex items-center justify-between bg-light-header dark:bg-dark-header">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-500 flex items-center justify-center">
                        <i class="bi bi-pencil-square text-sm"></i>
                    </div>
                    <h3 class="text-sm font-bold text-light-text dark:text-white" id="composerModalLabel">Tulis Pesan Baru</h3>
                </div>
                <button type="button" onclick="closeComposer()" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white p-1">
                    <i class="bi bi-x-lg text-sm"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-4 overflow-y-auto space-y-3 flex-1">
                <form id="composeForm">
                    <!-- To -->
                    <div class="relative">
                        <div class="flex items-center rounded-lg border border-light-border dark:border-dark-border bg-slate-50 dark:bg-dark-bg focus-within:border-cyan-500 overflow-hidden">
                            <span class="px-3 py-1.5 text-xs font-semibold text-light-muted dark:text-dark-muted bg-slate-100 dark:bg-dark-header border-r border-light-border dark:border-dark-border w-20">Kepada:</span>
                            <input type="text" id="composeTo" class="flex-1 px-3 py-1.5 text-xs bg-transparent text-light-text dark:text-white placeholder:text-light-muted dark:placeholder:text-dark-muted focus:outline-none" placeholder="penerima@domain.com" required autocomplete="off" oninput="handleContactAutoComplete(this, 'toSug')">
                            <button type="button" onclick="toggleCcBcc()" class="px-2.5 py-1 text-xs text-light-muted dark:text-dark-muted hover:text-cyan-500 font-medium">Cc / Bcc</button>
                        </div>
                        <div id="toSug" class="absolute w-full mt-1 bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border rounded-lg shadow-lg z-50 hidden divide-y divide-light-border dark:divide-dark-border"></div>
                    </div>

                    <!-- Cc & Bcc -->
                    <div id="ccBccContainer" class="hidden space-y-2 mt-2">
                        <div class="relative">
                            <div class="flex items-center rounded-lg border border-light-border dark:border-dark-border bg-slate-50 dark:bg-dark-bg focus-within:border-cyan-500 overflow-hidden">
                                <span class="px-3 py-1.5 text-xs font-semibold text-light-muted dark:text-dark-muted bg-slate-100 dark:bg-dark-header border-r border-light-border dark:border-dark-border w-20">Cc:</span>
                                <input type="text" id="composeCc" class="flex-1 px-3 py-1.5 text-xs bg-transparent text-light-text dark:text-white placeholder:text-light-muted dark:placeholder:text-dark-muted focus:outline-none" placeholder="cc1@domain.com, cc2@domain.com" autocomplete="off" oninput="handleContactAutoComplete(this, 'ccSug')">
                            </div>
                            <div id="ccSug" class="absolute w-full mt-1 bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border rounded-lg shadow-lg z-50 hidden divide-y divide-light-border dark:divide-dark-border"></div>
                        </div>
                        <div class="relative">
                            <div class="flex items-center rounded-lg border border-light-border dark:border-dark-border bg-slate-50 dark:bg-dark-bg focus-within:border-cyan-500 overflow-hidden">
                                <span class="px-3 py-1.5 text-xs font-semibold text-light-muted dark:text-dark-muted bg-slate-100 dark:bg-dark-header border-r border-light-border dark:border-dark-border w-20">Bcc:</span>
                                <input type="text" id="composeBcc" class="flex-1 px-3 py-1.5 text-xs bg-transparent text-light-text dark:text-white placeholder:text-light-muted dark:placeholder:text-dark-muted focus:outline-none" placeholder="bcc@domain.com" autocomplete="off" oninput="handleContactAutoComplete(this, 'bccSug')">
                            </div>
                            <div id="bccSug" class="absolute w-full mt-1 bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border rounded-lg shadow-lg z-50 hidden divide-y divide-light-border dark:divide-dark-border"></div>
                        </div>
                    </div>

                    <!-- Subject -->
                    <div class="flex items-center rounded-lg border border-light-border dark:border-dark-border bg-slate-50 dark:bg-dark-bg focus-within:border-cyan-500 overflow-hidden mt-2">
                        <span class="px-3 py-1.5 text-xs font-semibold text-light-muted dark:text-dark-muted bg-slate-100 dark:bg-dark-header border-r border-light-border dark:border-dark-border w-20">Subjek:</span>
                        <input type="text" id="composeSubject" class="flex-1 px-3 py-1.5 text-xs font-semibold bg-transparent text-light-text dark:text-white placeholder:text-light-muted dark:placeholder:text-dark-muted focus:outline-none" placeholder="Subjek email..." required>
                    </div>

                    <!-- Editor Toolbar -->
                    <div class="flex items-center justify-between p-2 rounded-t-lg border-t border-x border-light-border dark:border-dark-border bg-slate-100 dark:bg-dark-header mt-2">
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="formatDoc('bold')" class="p-1 text-xs text-light-muted dark:text-dark-muted hover:text-cyan-500 rounded" title="Tebal (Ctrl+B)"><i class="bi bi-type-bold"></i></button>
                            <button type="button" onclick="formatDoc('italic')" class="p-1 text-xs text-light-muted dark:text-dark-muted hover:text-cyan-500 rounded" title="Miring (Ctrl+I)"><i class="bi bi-type-italic"></i></button>
                            <button type="button" onclick="formatDoc('underline')" class="p-1 text-xs text-light-muted dark:text-dark-muted hover:text-cyan-500 rounded" title="Garis Bawah (Ctrl+U)"><i class="bi bi-type-underline"></i></button>
                            <div class="h-3 w-px bg-light-border dark:bg-dark-border mx-1"></div>
                            <button type="button" onclick="formatDoc('insertUnorderedList')" class="p-1 text-xs text-light-muted dark:text-dark-muted hover:text-cyan-500 rounded" title="Bullet List"><i class="bi bi-list-ul"></i></button>
                            <button type="button" onclick="formatDoc('insertOrderedList')" class="p-1 text-xs text-light-muted dark:text-dark-muted hover:text-cyan-500 rounded" title="Numbered List"><i class="bi bi-list-ol"></i></button>
                            <div class="h-3 w-px bg-light-border dark:bg-dark-border mx-1"></div>
                            <button type="button" onclick="insertLinkPrompt()" class="p-1 text-xs text-light-muted dark:text-dark-muted hover:text-cyan-500 rounded" title="Sisipkan Link"><i class="bi bi-link-45deg"></i></button>
                            <button type="button" onclick="formatDoc('removeFormat')" class="p-1 text-xs text-light-muted dark:text-dark-muted hover:text-cyan-500 rounded" title="Hapus Format"><i class="bi bi-eraser"></i></button>
                        </div>
                        <div class="relative">
                            <button type="button" onclick="toggleTemplatesDropdown()" class="px-2 py-0.5 text-xs text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white rounded border border-light-border dark:border-dark-border flex items-center gap-1">
                                <i class="bi bi-file-text"></i>
                                <span>Template</span>
                            </button>
                            <div id="cannedDropdownMenu" class="absolute right-0 mt-1 w-48 bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border rounded-lg shadow-lg z-50 hidden py-1">
                                <div id="cannedTemplatesDropdown"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Editable Content Area -->
                    <div id="composeEditor" class="min-h-[160px] max-h-[260px] overflow-y-auto p-3 text-xs rounded-b-lg border border-light-border dark:border-dark-border bg-white dark:bg-dark-card text-light-text dark:text-white focus:outline-none focus:border-cyan-500" contenteditable="true" placeholder="Tulis pesan Anda di sini..."></div>

                    <!-- Auto-Save Status -->
                    <div class="flex items-center justify-between text-[11px] text-light-muted dark:text-dark-muted pt-1">
                        <span id="draftSaveStatus" class="flex items-center gap-1">
                            <i class="bi bi-cloud-check text-emerald-500"></i> Draf otomatis disimpan
                        </span>
                        <button type="button" onclick="clearDraft()" class="text-light-muted dark:text-dark-muted hover:text-rose-500 transition-colors flex items-center gap-1">
                            <i class="bi bi-trash"></i> Hapus Draf
                        </button>
                    </div>

                    <!-- Attachments List -->
                    <div id="composerAttachments" class="flex flex-wrap gap-2 mt-2"></div>

                    <!-- Scheduler Box -->
                    <div id="scheduleTimeBox" class="hidden mt-3 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-amber-500 flex items-center gap-1.5">
                                <i class="bi bi-clock-history"></i> Pilih Waktu Penjadwalan:
                            </span>
                            <button type="button" onclick="toggleScheduleBox()" class="text-amber-500 hover:text-amber-400">
                                <i class="bi bi-x-lg text-xs"></i>
                            </button>
                        </div>
                        <input type="datetime-local" id="scheduleDatetimeInput" class="w-full px-3 py-1.5 text-xs rounded-lg border border-amber-500/30 bg-light-card dark:bg-dark-card text-light-text dark:text-white focus:outline-none">
                    </div>
                </form>
            </div>

            <!-- Modal Footer -->
            <div class="px-4 py-3 border-t border-light-border dark:border-dark-border bg-light-header dark:bg-dark-header flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <input type="file" id="composerFileInput" class="hidden" multiple onchange="handleFileSelect(event)">
                    <button type="button" onclick="document.getElementById('composerFileInput').click()" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-light-text dark:text-white hover:bg-slate-100 dark:hover:bg-dark-card border border-light-border dark:border-dark-border transition-all flex items-center gap-1.5">
                        <i class="bi bi-paperclip"></i>
                        <span>Lampiran</span>
                    </button>
                    <button type="button" onclick="toggleScheduleBox()" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-amber-500 hover:bg-amber-500/10 border border-amber-500/20 transition-all flex items-center gap-1.5">
                        <i class="bi bi-alarm"></i>
                        <span>Jadwalkan</span>
                    </button>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="closeComposer()" class="px-3 py-1.5 rounded-lg text-xs font-medium text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white border border-light-border dark:border-dark-border">
                        Tutup
                    </button>
                    <button type="button" id="btnSendMail" onclick="submitSendOrScheduleEmail()" class="px-4 py-1.5 rounded-lg text-xs font-semibold text-white bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 shadow-cyan-glow transition-all flex items-center gap-1.5">
                        <i class="bi bi-send-fill text-xs"></i>
                        <span>Kirim Sekarang</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 2: ATTACHMENT PREVIEW MODAL -->
    <div id="attachmentPreviewModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border rounded-2xl w-full max-w-4xl shadow-card-dark overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-4 py-3 border-b border-light-border dark:border-dark-border flex items-center justify-between bg-light-header dark:bg-dark-header">
                <h3 class="text-sm font-bold text-light-text dark:text-white truncate flex items-center gap-2" id="attachmentPreviewTitle">
                    <i class="bi bi-file-earmark-text text-cyan-500"></i> Preview Lampiran
                </h3>
                <div class="flex items-center gap-2">
                    <a id="btnDownloadPreview" href="#" download="" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 hover:bg-cyan-500/20 transition-all flex items-center gap-1">
                        <i class="bi bi-download"></i> Unduh
                    </a>
                    <button type="button" onclick="closeAttachmentPreviewModal()" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white p-1">
                        <i class="bi bi-x-lg text-sm"></i>
                    </button>
                </div>
            </div>
            <div class="p-4 text-center overflow-auto flex-1 min-h-[350px]" id="attachmentPreviewContent"></div>
        </div>
    </div>

    <!-- MODAL 3: SECURITY SETTINGS & 2FA / API KEYS -->
    <div id="securitySettingsModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border rounded-2xl w-full max-w-2xl shadow-card-dark overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-4 py-3 border-b border-light-border dark:border-dark-border flex items-center justify-between bg-light-header dark:bg-dark-header">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-500 flex items-center justify-center">
                        <i class="bi bi-shield-lock-fill text-sm"></i>
                    </div>
                    <h3 class="text-sm font-bold text-light-text dark:text-white">Keamanan Akun, 2FA & API Keys</h3>
                </div>
                <button type="button" onclick="closeSecuritySettingsModal()" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white p-1">
                    <i class="bi bi-x-lg text-sm"></i>
                </button>
            </div>
            <div class="p-4 overflow-y-auto space-y-4 flex-1">
                <!-- Tabs -->
                <div class="flex border-b border-light-border dark:border-dark-border gap-4">
                    <button id="tab2faBtn" onclick="switchSecurityTab('2fa')" class="pb-2 text-xs font-semibold border-b-2 border-cyan-500 text-cyan-600 dark:text-cyan-400">
                        <i class="bi bi-shield-check mr-1"></i>Otentikasi Dua Faktor (2FA)
                    </button>
                    <button id="tabApiKeysBtn" onclick="switchSecurityTab('apikeys')" class="pb-2 text-xs font-medium text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white">
                        <i class="bi bi-code-square mr-1"></i>Developer API Keys
                    </button>
                </div>

                <!-- 2FA Tab Pane -->
                <div id="secTab2fa" class="space-y-4">
                    <div id="twoFAAlert" class="hidden p-3 rounded-xl text-xs"></div>

                    {{ if .current_user.TwoFactorEnabled }}
                    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-between">
                        <div>
                            <h4 class="text-xs font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5 mb-1">
                                <i class="bi bi-check-circle-fill"></i> 2FA Sedang Aktif
                            </h4>
                            <p class="text-[11px] text-light-muted dark:text-dark-muted">Akun Anda dilindungi dengan enkripsi TOTP RFC 6238.</p>
                        </div>
                        <button onclick="toggleDisable2FASection()" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-rose-500 hover:text-white hover:bg-rose-600 border border-rose-500/30 transition-all">
                            Nonaktifkan 2FA
                        </button>
                    </div>

                    <div id="disable2FASection" class="hidden p-3 rounded-xl bg-rose-500/5 border border-rose-500/20 space-y-2">
                        <h5 class="text-xs font-bold text-rose-500">Konfirmasi Penonaktifan 2FA</h5>
                        <p class="text-[11px] text-light-muted dark:text-dark-muted">Masukkan kata sandi akun Anda untuk mengonfirmasi:</p>
                        <div class="flex gap-2 max-w-sm">
                            <input type="password" id="disable2FAPassword" class="flex-1 px-3 py-1.5 text-xs rounded-lg border border-light-border dark:border-dark-border bg-light-card dark:bg-dark-card text-light-text dark:text-white focus:outline-none" placeholder="Kata sandi saat ini">
                            <button onclick="submitDisable2FA()" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-rose-600 hover:bg-rose-500">Nonaktifkan</button>
                        </div>
                    </div>
                    {{ else }}
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-dark-header border border-light-border dark:border-dark-border space-y-3">
                        <h4 class="text-xs font-bold text-light-text dark:text-white flex items-center gap-1.5">
                            <i class="bi bi-shield-plus text-cyan-500"></i> Aktifkan Autentikasi Dua Langkah
                        </h4>
                        <p class="text-[11px] text-light-muted dark:text-dark-muted">Gunakan aplikasi seperti Google Authenticator atau Bitwarden untuk menghasilkan token 6-digit.</p>

                        <div id="setup2FASteps" class="hidden space-y-3">
                            <div class="p-3 bg-white dark:bg-dark-card border border-light-border dark:border-dark-border rounded-xl space-y-2">
                                <span class="text-[11px] font-semibold text-light-muted dark:text-dark-muted block">1. Masukkan Secret Key ke aplikasi Authenticator:</span>
                                <input type="text" id="twoFASecretInput" class="w-full px-3 py-1.5 text-xs font-mono font-bold rounded-lg border border-light-border dark:border-dark-border bg-slate-50 dark:bg-dark-header text-cyan-600 dark:text-cyan-400" readonly>
                                <textarea id="twoFAUriInput" class="w-full px-3 py-1.5 text-[10px] font-mono rounded-lg border border-light-border dark:border-dark-border bg-slate-50 dark:bg-dark-header text-light-muted dark:text-dark-muted" rows="2" readonly></textarea>
                            </div>
                            <div class="p-3 bg-white dark:bg-dark-card border border-light-border dark:border-dark-border rounded-xl space-y-2">
                                <span class="text-[11px] font-semibold text-light-muted dark:text-dark-muted block">2. Masukkan 6-digit kode verifikasi:</span>
                                <div class="flex gap-2 max-w-xs">
                                    <input type="text" id="twoFAVerifyCode" class="flex-1 px-3 py-1.5 text-center text-xs font-mono font-bold rounded-lg border border-light-border dark:border-dark-border bg-slate-50 dark:bg-dark-header text-light-text dark:text-white focus:outline-none" placeholder="123456" maxlength="6">
                                    <button onclick="submitEnable2FA()" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-cyan-600 hover:bg-cyan-500">Aktifkan</button>
                                </div>
                            </div>
                        </div>

                        <div id="backupCodesDisplay" class="hidden p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 space-y-2">
                            <h5 class="text-xs font-bold text-amber-500 flex items-center gap-1.5">
                                <i class="bi bi-key-fill"></i> Simpan Kode Pemulihan Cadangan Anda!
                            </h5>
                            <div id="backupCodesList" class="grid grid-cols-2 gap-2 text-xs font-mono font-bold p-2 bg-white dark:bg-dark-card rounded-lg border border-light-border dark:border-dark-border"></div>
                        </div>

