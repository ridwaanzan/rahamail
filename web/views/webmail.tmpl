                        <div class="flex gap-2">
                            <input type="text" id="newKeyToken" class="flex-1 px-3 py-1.5 text-xs font-mono font-bold rounded-lg border border-light-border dark:border-dark-border bg-white dark:bg-dark-card text-light-text dark:text-white" readonly>
                            <button onclick="navigator.clipboard.writeText(document.getElementById('newKeyToken').value); alert('Token disalin!');" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-light-border dark:border-dark-border bg-slate-100 dark:bg-dark-header">Salin</button>
