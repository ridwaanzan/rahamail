<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .title }}</title>
    <link rel="stylesheet" href="/static/css/bootstrap.min.css">
    <link rel="stylesheet" href="/static/css/bootstrap-icons.min.css">
    <style>
        :root {
            --primary-color: #2563eb;
            --primary-hover: #1d4ed8;
            --sidebar-bg: #f8fafc;
            --border-color: #e2e8f0;
            --text-main: #0f172a;
            --text-muted: #64748b;
        }
        body {
            background-color: #f1f5f9;
            color: var(--text-main);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            height: 100vh;
            overflow: hidden;
        }
        .webmail-sidebar {
            width: 250px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        .nav-folder-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.6rem 0.85rem;
            color: var(--text-muted);
            text-decoration: none;
            border-radius: 0.5rem;
            margin-bottom: 0.25rem;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.15s ease;
        }
        .nav-folder-link:hover {
            background-color: #e2e8f0;
            color: var(--primary-color);
        }
        .nav-folder-link.active {
            background-color: var(--primary-color);
            color: #ffffff;
        }
        .brand-badge {
            background: linear-gradient(135deg, #2563eb 0%, #38bdf8 100%);
        }
        
        /* Split Pane Styling */
        .mail-list-pane {
            width: 420px;
            min-width: 340px;
            border-right: 1px solid var(--border-color);
            background: #ffffff;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        .mail-reader-pane {
            flex: 1;
            background: #f8fafc;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }
        .mail-item {
            cursor: pointer;
            border-bottom: 1px solid var(--border-color);
            padding: 0.85rem 1rem;
            background: #ffffff;
            transition: background 0.15s ease;
        }
        .mail-item:hover {
            background-color: #f1f5f9;
        }
        .mail-item.selected {
            background-color: #e0f2fe;
            border-left: 3px solid var(--primary-color);
        }
        .mail-item.unread {
            font-weight: 600;
        }
        .mail-item.unread .mail-subject {
            color: #0f172a;
        }
        .mail-item.unread .mail-from {
            color: var(--primary-color);
        }
        .reader-body-frame {
            width: 100%;
            height: 100%;
            border: 1px solid var(--border-color);
            background: #ffffff;
            border-radius: 8px;
        }

        /* Composer Modal Styling */
        .composer-editor-toolbar {
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            border-bottom: none;
            border-radius: 6px 6px 0 0;
            padding: 6px;
            display: flex;
            gap: 4px;
        }
        .composer-editor-toolbar button {
            background: transparent;
            border: none;
            color: #475569;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.85rem;
        }
        .composer-editor-toolbar button:hover {
            background: #e2e8f0;
            color: var(--primary-color);
        }
        .composer-editor-area {
            min-height: 200px;
            max-height: 320px;
            overflow-y: auto;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 0 0 6px 6px;
            padding: 12px;
            color: #0f172a;
            outline: none;
        }
        .composer-editor-area:focus {
            border-color: var(--primary-color);
        }
        .attachment-chip {
            background: #e2e8f0;
            border: 1px solid #cbd5e1;
            border-radius: 16px;
            padding: 3px 10px;
            font-size: 0.78rem;
            color: #1e293b;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
    </style>
</head>
<body class="d-flex">
    <!-- 1. SIDEBAR -->
    <aside class="webmail-sidebar p-3">
        <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
            <div class="brand-badge p-2 rounded-3 me-2 text-white">
                <i class="bi bi-envelope-fill fs-5"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0 text-dark">RaHaMail</h6>
                <small class="text-secondary" style="font-size: 0.72rem;">Webmail Client</small>
            </div>
        </div>

        <button class="btn btn-primary w-100 py-2 mb-3 fw-semibold rounded-3 shadow-sm d-flex align-items-center justify-content-center" onclick="openComposer()">
            <i class="bi bi-pencil-square me-2"></i>Tulis Email
        </button>

        <nav class="flex-grow-1">
            <a href="/mail?folder=INBOX" class="nav-folder-link {{ if eq .current_folder "INBOX" }}active{{ end }}">
                <span><i class="bi bi-inbox-fill me-2"></i>Kotak Masuk</span>
                <span class="badge {{ if eq .current_folder "INBOX" }}bg-white text-primary{{ else }}bg-secondary-subtle text-secondary{{ end }} rounded-pill" id="inboxCountBadge">{{ len .messages }}</span>
            </a>
            <a href="/mail?folder=Sent" class="nav-folder-link {{ if eq .current_folder "Sent" }}active{{ end }}">
                <span><i class="bi bi-send-fill me-2"></i>Terkirim</span>
            </a>
            <a href="/mail?folder=Scheduled" class="nav-folder-link {{ if eq .current_folder "Scheduled" }}active{{ end }}">
                <span><i class="bi bi-clock-history me-2"></i>Terjadwal</span>
                {{ if gt .scheduled_count 0 }}
                <span class="badge bg-warning text-dark rounded-pill">{{ .scheduled_count }}</span>
                {{ end }}
            </a>
            <a href="/mail?folder=Drafts" class="nav-folder-link {{ if eq .current_folder "Drafts" }}active{{ end }}">
                <span><i class="bi bi-file-earmark-text-fill me-2"></i>Draf</span>
            </a>
            <a href="/mail?folder=Spam" class="nav-folder-link {{ if eq .current_folder "Spam" }}active{{ end }}">
                <span><i class="bi bi-shield-slash-fill me-2"></i>Spam</span>
            </a>
            <a href="/mail?folder=Trash" class="nav-folder-link {{ if eq .current_folder "Trash" }}active{{ end }}">
                <span><i class="bi bi-trash-fill me-2"></i>Sampah</span>
            </a>
        </nav>

        <!-- Storage & User info -->
        <div class="pt-3 border-top">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="small text-secondary" style="font-size: 0.75rem;"><i class="bi bi-hdd-fill me-1"></i>Penyimpanan</span>
                <span class="small text-secondary" style="font-size: 0.75rem;">{{ .storage_used }} MB / {{ .storage_quota }} MB</span>
            </div>
            <div class="progress mb-3" style="height: 5px;">
                <div class="progress-bar bg-primary" role="progressbar" style="width: 2%"></div>
            </div>

            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center text-truncate me-2">
                    <i class="bi bi-person-circle fs-5 text-secondary me-2"></i>
                    <div class="text-truncate">
                        <div class="small fw-semibold text-dark text-truncate">{{ .current_user.Email }}</div>
                        <div class="text-secondary" style="font-size: 0.68rem;">Mailbox User</div>
                    </div>
                </div>
                <a href="/logout" class="btn btn-sm btn-outline-danger p-1 px-2" title="Keluar">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- 2. MESSAGE LIST PANE -->
    <div class="mail-list-pane">
        <!-- List Header -->
        <div class="p-3 border-bottom bg-light">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="fw-bold mb-0 text-dark">
                    {{ if eq .current_folder "Scheduled" }}
                    <i class="bi bi-clock-history text-warning me-1"></i>Email Terjadwal
                    {{ else }}
                    {{ .current_folder }}
                    {{ end }}
                </h6>
                <div>
                    {{ if .current_user.IsAdmin }}
                    <a href="/" class="btn btn-sm btn-outline-primary p-1 px-2 me-1" title="Dashboard Admin">
                        <i class="bi bi-speedometer2"></i>
                    </a>
                    {{ end }}
                    <button class="btn btn-sm btn-outline-secondary p-1 px-2" onclick="location.reload()" title="Segarkan">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
            <!-- Search bar -->
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white text-secondary"><i class="bi bi-search"></i></span>
                <input type="text" id="searchInput" class="form-control" placeholder="Cari pesan..." onkeyup="filterMessages()">
            </div>
        </div>

        <!-- Mail Items -->
        <div class="flex-grow-1 overflow-auto" id="mailListContainer">
            {{ if eq .current_folder "Scheduled" }}
                <!-- List Email Terjadwal -->
                {{ range .scheduled_mails }}
                <div class="mail-item" id="sched-item-{{ .ID }}">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="small text-warning fw-semibold text-truncate pe-2">
                            <i class="bi bi-clock me-1"></i>{{ .ScheduledAt.Format "02 Jan 15:04" }}
                        </span>
                        <span class="badge {{ if eq .Status "pending" }}bg-warning-subtle text-warning{{ else if eq .Status "sent" }}bg-success-subtle text-success{{ else }}bg-danger-subtle text-danger{{ end }}" style="font-size: 0.65rem;">
                            {{ .Status }}
                        </span>
                    </div>
                    <div class="mail-subject small mb-1 text-truncate text-dark fw-semibold">{{ .Subject }}</div>
                    <div class="text-secondary text-truncate" style="font-size: 0.75rem;">Kepada: {{ .To }}</div>
                    {{ if eq .Status "pending" }}
                    <div class="mt-2 text-end">
                        <button class="btn btn-xs btn-outline-danger py-0 px-2 small" style="font-size: 0.7rem;" onclick="cancelSchedule({{ .ID }})">
                            <i class="bi bi-x-circle me-1"></i>Batalkan
                        </button>
                    </div>
                    {{ end }}
                </div>
                {{ else }}
                <div class="text-center py-5 text-secondary">
                    <i class="bi bi-clock-history fs-1 d-block mb-2 opacity-50"></i>
                    Tidak ada email yang sedang dijadwalkan.
                </div>
                {{ end }}
            {{ else }}
                <!-- List Email Reguler -->
                {{ range .messages }}
                <div class="mail-item {{ if not .IsSeen }}unread{{ end }}" id="msg-item-{{ .ID }}" onclick="loadMessageDetail({{ .ID }})">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="mail-from small text-truncate pe-2">{{ .From }}</span>
                        <span class="text-secondary" style="font-size: 0.72rem;">{{ .ReceivedAt.Format "02 Jan 15:04" }}</span>
                    </div>
                    <div class="mail-subject small mb-1 text-truncate">{{ .Subject }}</div>
                    <div class="text-secondary text-truncate" style="font-size: 0.75rem;">{{ .Snippet }}</div>
                    <div class="d-flex align-items-center mt-2 justify-content-between">
                        <div>
                            <span class="badge bg-success-subtle text-success" style="font-size: 0.65rem;">SPF: {{ .SPFStatus }}</span>
                            <span class="badge bg-info-subtle text-info" style="font-size: 0.65rem;">DKIM: {{ .DKIMStatus }}</span>
                        </div>
                        <button class="btn btn-sm p-0 text-secondary" onclick="toggleStar(event, {{ .ID }})" id="star-btn-{{ .ID }}">
                            <i class="bi {{ if .IsFlagged }}bi-star-fill text-warning{{ else }}bi-star{{ end }}"></i>
                        </button>
                    </div>
                </div>
                {{ else }}
                <div class="text-center py-5 text-secondary">
                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                    Belum ada email di folder ini.
                </div>
                {{ end }}
            {{ end }}
        </div>
    </div>

    <!-- 3. MESSAGE READER PANE (Split View) -->
    <main class="mail-reader-pane">
        <!-- Placeholder Empty State -->
        <div id="readerEmptyState" class="h-100 d-flex flex-column align-items-center justify-content-center text-secondary">
            <i class="bi bi-envelope-open fs-1 opacity-25 mb-3"></i>
            <h6>Pilih email di sebelah kiri untuk membaca</h6>
            <small class="opacity-75">RaHaMail Webmail Reader Engine v1.0</small>
        </div>

        <!-- Reader Container (Hidden by default) -->
        <div id="readerContainer" class="d-none h-100 d-flex flex-column">
            <!-- Reader Action Toolbar -->
            <div class="p-3 border-bottom bg-white d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" onclick="replyCurrentMail()" title="Balas"><i class="bi bi-reply-fill me-1"></i>Balas</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="forwardCurrentMail()" title="Teruskan"><i class="bi bi-forward-fill me-1"></i>Teruskan</button>
                    <div class="vr mx-1 my-1"></div>
                    <button class="btn btn-sm btn-outline-warning" onclick="moveCurrentMail('Spam')" title="Tandai Spam"><i class="bi bi-shield-slash me-1"></i>Spam</button>
                    <button class="btn btn-sm btn-outline-danger" onclick="moveCurrentMail('Trash')" title="Buang ke Sampah"><i class="bi bi-trash me-1"></i>Hapus</button>
                </div>
                <div>
                    <span id="readMailDate" class="text-secondary small me-2"></span>
                </div>
            </div>

            <!-- Email Headers Detail -->
            <div class="p-3 border-bottom bg-white">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <h5 id="readMailSubject" class="fw-bold text-dark mb-2"></h5>
                        <div class="d-flex align-items-center mb-1">
                            <span class="badge bg-primary me-2">Dari</span>
                            <span id="readMailFrom" class="text-primary fw-semibold small"></span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="badge bg-secondary me-2">Kepada</span>
                            <span id="readMailTo" class="text-dark small"></span>
                        </div>
                    </div>
                    <div class="text-end">
                        <span id="spfBadge" class="badge bg-success-subtle text-success me-1">SPF: PASS</span>
                        <span id="dkimBadge" class="badge bg-info-subtle text-info me-1">DKIM: PASS</span>
                        <span id="dmarcBadge" class="badge bg-secondary-subtle text-secondary">DMARC: PASS</span>
                    </div>
                </div>

                <!-- Attachment Area -->
                <div id="attachmentArea" class="d-none mt-3 pt-2 border-top">
                    <small class="fw-semibold text-secondary d-block mb-1"><i class="bi bi-paperclip me-1"></i>Lampiran File:</small>
                    <div id="attachmentList" class="d-flex flex-wrap gap-2"></div>
                </div>
            </div>

            <!-- Email Body Content (Sandboxed IFrame anti-XSS) -->
            <div class="p-3 flex-grow-1 overflow-hidden d-flex flex-column">
                <div id="textContentContainer" class="p-3 rounded bg-white border h-100 overflow-auto d-none text-dark" style="white-space: pre-wrap; font-family: monospace;"></div>
                <iframe id="htmlContentFrame" class="reader-body-frame d-none" sandbox="allow-same-origin"></iframe>
            </div>
        </div>
    </main>

    <!-- 4. RICH-TEXT COMPOSER MODAL (FASE 4 & 5) -->
    <div class="modal fade" id="composerModal" tabindex="-1" aria-labelledby="composerModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-white text-dark shadow-lg">
                <div class="modal-header border-bottom py-2">
                    <h6 class="modal-title fw-bold" id="composerModalLabel">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Tulis Pesan Baru
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <form id="composeForm">
                        <!-- To -->
                        <div class="mb-2">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-secondary" style="width: 75px;">Kepada:</span>
                                <input type="text" id="composeTo" class="form-control" placeholder="penerima@domain.com" required>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleCcBcc()">Cc / Bcc</button>
                            </div>
                        </div>

                        <!-- Cc & Bcc (Toggleable) -->
                        <div id="ccBccContainer" class="d-none">
                            <div class="mb-2">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary" style="width: 75px;">Cc:</span>
                                    <input type="text" id="composeCc" class="form-control" placeholder="cc1@domain.com, cc2@domain.com">
                                </div>
                            </div>
                            <div class="mb-2">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary" style="width: 75px;">Bcc:</span>
                                    <input type="text" id="composeBcc" class="form-control" placeholder="bcc@domain.com">
                                </div>
                            </div>
                        </div>

                        <!-- Subject -->
                        <div class="mb-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-secondary" style="width: 75px;">Subjek:</span>
                                <input type="text" id="composeSubject" class="form-control fw-semibold" placeholder="Subjek email..." required>
                            </div>
                        </div>

                        <!-- Rich Text WYSIWYG Toolbar -->
                        <div class="composer-editor-toolbar">
                            <button type="button" onclick="formatDoc('bold')" title="Tebal (Ctrl+B)"><i class="bi bi-type-bold"></i></button>
                            <button type="button" onclick="formatDoc('italic')" title="Miring (Ctrl+I)"><i class="bi bi-type-italic"></i></button>
                            <button type="button" onclick="formatDoc('underline')" title="Garis Bawah (Ctrl+U)"><i class="bi bi-type-underline"></i></button>
                            <div class="vr my-1 bg-secondary opacity-25"></div>
                            <button type="button" onclick="formatDoc('insertUnorderedList')" title="Daftar Bullet"><i class="bi bi-list-ul"></i></button>
                            <button type="button" onclick="formatDoc('insertOrderedList')" title="Daftar Angka"><i class="bi bi-list-ol"></i></button>
                            <div class="vr my-1 bg-secondary opacity-25"></div>
                            <button type="button" onclick="insertLinkPrompt()" title="Sisipkan Tautan"><i class="bi bi-link-45deg"></i></button>
                            <button type="button" onclick="formatDoc('removeFormat')" title="Hapus Format"><i class="bi bi-eraser"></i></button>
                        </div>

                        <!-- Editable Content Area -->
                        <div id="composeEditor" class="composer-editor-area" contenteditable="true" placeholder="Tulis pesan Anda di sini..."></div>

                        <!-- Attachment Chips Area -->
                        <div id="composerAttachments" class="d-flex flex-wrap gap-2 mt-2"></div>

                        <!-- Scheduler Box (Fase 5) -->
                        <div id="scheduleTimeBox" class="d-none mt-3 p-2 rounded bg-warning-subtle border border-warning">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="small fw-semibold text-warning-emphasis"><i class="bi bi-clock-history me-1"></i>Pilih Waktu Penjadwalan:</span>
                                <button type="button" class="btn-close small" style="transform: scale(0.7);" onclick="toggleScheduleBox()"></button>
                            </div>
                            <input type="datetime-local" id="scheduleDatetimeInput" class="form-control form-control-sm">
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-top py-2 d-flex justify-content-between">
                    <div>
                        <!-- Hidden file input for attachments -->
                        <input type="file" id="composerFileInput" class="d-none" multiple onchange="handleFileSelect(event)">
                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="document.getElementById('composerFileInput').click()">
                            <i class="bi bi-paperclip me-1"></i>Lampiran
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning" onclick="toggleScheduleBox()">
                            <i class="bi bi-alarm me-1"></i>Jadwalkan
                        </button>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                        <button type="button" id="btnSendMail" class="btn btn-sm btn-primary px-3 fw-semibold" onclick="submitSendOrScheduleEmail()">
                            <i class="bi bi-send-fill me-1"></i>Kirim Sekarang
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/static/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentLoadedMailId = null;
        let composerModalInstance = null;
        let selectedAttachments = [];
        let isScheduleMode = false;

        document.addEventListener('DOMContentLoaded', () => {
            composerModalInstance = new bootstrap.Modal(document.getElementById('composerModal'));
        });

        function openComposer(to = '', subject = '', body = '') {
            document.getElementById('composeTo').value = to;
            document.getElementById('composeSubject').value = subject;
            document.getElementById('composeEditor').innerHTML = body;
            document.getElementById('composeCc').value = '';
            document.getElementById('composeBcc').value = '';
            selectedAttachments = [];
            isScheduleMode = false;
            document.getElementById('scheduleTimeBox').classList.add('d-none');
            document.getElementById('btnSendMail').innerHTML = '<i class="bi bi-send-fill me-1"></i>Kirim Sekarang';
            renderAttachmentChips();
            composerModalInstance.show();
        }

        function toggleCcBcc() {
            const container = document.getElementById('ccBccContainer');
            container.classList.toggle('d-none');
        }

        function toggleScheduleBox() {
            const box = document.getElementById('scheduleTimeBox');
            const btn = document.getElementById('btnSendMail');
            isScheduleMode = !isScheduleMode;

            if (isScheduleMode) {
                box.classList.remove('d-none');
                btn.innerHTML = '<i class="bi bi-clock-history me-1"></i>Jadwalkan Pengiriman';
                btn.className = 'btn btn-sm btn-warning px-3 fw-semibold text-dark';
                // Set default waktu besok pukul 08:00
                const tomorrow = new Date();
                tomorrow.setDate(tomorrow.getDate() + 1);
                tomorrow.setHours(8, 0, 0, 0);
                const isoStr = new Date(tomorrow.getTime() - tomorrow.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
                document.getElementById('scheduleDatetimeInput').value = isoStr;
            } else {
                box.classList.add('d-none');
                btn.innerHTML = '<i class="bi bi-send-fill me-1"></i>Kirim Sekarang';
                btn.className = 'btn btn-sm btn-primary px-3 fw-semibold';
            }
        }

        function formatDoc(cmd, val = null) {
            document.execCommand(cmd, false, val);
            document.getElementById('composeEditor').focus();
        }

        function insertLinkPrompt() {
            const url = prompt('Masukkan URL tautan:');
            if (url) formatDoc('createLink', url);
        }

        function handleFileSelect(event) {
            const files = event.target.files;
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                if (file.size > 15 * 1024 * 1024) {
                    alert(`File ${file.name} melebihi batas 15MB.`);
                    continue;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    selectedAttachments.push({
                        file_name: file.name,
                        content_type: file.type || 'application/octet-stream',
                        size: file.size,
                        data_base64: e.target.result
                    });
                    renderAttachmentChips();
                };
                reader.readAsDataURL(file);
            }
            event.target.value = '';
        }

        function renderAttachmentChips() {
            const container = document.getElementById('composerAttachments');
            container.innerHTML = '';
            selectedAttachments.forEach((att, idx) => {
                const chip = document.createElement('div');
                chip.className = 'attachment-chip';
                chip.innerHTML = `
                    <i class="bi bi-file-earmark"></i>
                    <span>${att.file_name} (${(att.size / 1024).toFixed(0)} KB)</span>
                    <i class="bi bi-x-circle text-danger ms-1 cursor-pointer" onclick="removeAttachment(${idx})"></i>
                `;
                container.appendChild(chip);
            });
        }

        function removeAttachment(idx) {
            selectedAttachments.splice(idx, 1);
            renderAttachmentChips();
        }

        async function submitSendOrScheduleEmail() {
            const to = document.getElementById('composeTo').value.trim();
            const subject = document.getElementById('composeSubject').value.trim();
            const bodyHTML = document.getElementById('composeEditor').innerHTML;
            const bodyText = document.getElementById('composeEditor').innerText;
            const cc = document.getElementById('composeCc').value.trim();
            const bcc = document.getElementById('composeBcc').value.trim();
            const btn = document.getElementById('btnSendMail');

            if (!to) {
                alert('Silakan masukkan alamat penerima email (To).');
                return;
            }
            if (!subject) {
                alert('Silakan masukkan subjek email.');
                return;
            }

            btn.disabled = true;

            if (isScheduleMode) {
                const schedVal = document.getElementById('scheduleDatetimeInput').value;
                if (!schedVal) {
                    alert('Pilih tanggal dan jam pengiriman.');
                    btn.disabled = false;
                    return;
                }
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Menjadwalkan...';

                try {
                    const res = await fetch('/api/v1/webmail/schedule', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            to, cc, bcc, subject,
                            body_html: bodyHTML,
                            body_text: bodyText,
                            scheduled_at: schedVal
                        })
                    });
                    const data = await res.json();
                    if (res.ok && data.status === 'success') {
                        alert(data.message);
                        composerModalInstance.hide();
                        window.location.href = '/mail?folder=Scheduled';
                    } else {
                        alert('Gagal menjadwalkan: ' + (data.error || 'Terjadi kesalahan'));
                    }
                } catch (err) {
                    alert('Gagal menghubungi server.');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-clock-history me-1"></i>Jadwalkan Pengiriman';
                }
            } else {
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Mengirim...';

                try {
                    const res = await fetch('/api/v1/webmail/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            to, cc, bcc, subject,
                            body_html: bodyHTML,
                            body_text: bodyText,
                            attachments: selectedAttachments
                        })
                    });

                    const data = await res.json();
                    if (res.ok && data.status === 'success') {
                        alert('Email berhasil dikirim!');
                        composerModalInstance.hide();
                        location.reload();
                    } else {
                        alert('Gagal mengirim email: ' + (data.error || 'Terjadi kesalahan'));
                    }
                } catch (err) {
                    alert('Gagal terhubung ke server saat mengirim email.');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-send-fill me-1"></i>Kirim Sekarang';
                }
            }
        }

        async function cancelSchedule(id) {
            if (!confirm('Batalkan pengiriman email terjadwal ini?')) return;
            try {
                const res = await fetch(`/api/v1/webmail/schedule/${id}/cancel`, { method: 'POST' });
                const data = await res.json();
                if (res.ok && data.status === 'success') {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Gagal membatalkan: ' + (data.error || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Gagal terhubung ke server.');
            }
        }

        async function loadMessageDetail(id) {
            currentLoadedMailId = id;

            document.querySelectorAll('.mail-item').forEach(el => el.classList.remove('selected'));
            const activeItem = document.getElementById(`msg-item-${id}`);
            if (activeItem) {
                activeItem.classList.add('selected');
                activeItem.classList.remove('unread');
            }

            try {
                const res = await fetch(`/api/v1/webmail/messages/${id}`);
                if (!res.ok) throw new Error('Gagal memuat pesan');
                const data = await res.json();

                document.getElementById('readerEmptyState').classList.add('d-none');
                document.getElementById('readerContainer').classList.remove('d-none');

                const msg = data.message;
                const content = data.content;

                document.getElementById('readMailSubject').textContent = msg.subject || '(Tanpa Subjek)';
                document.getElementById('readMailFrom').textContent = msg.from;
                document.getElementById('readMailTo').textContent = msg.to;
                document.getElementById('readMailDate').textContent = new Date(msg.received_at).toLocaleString();

                document.getElementById('spfBadge').textContent = `SPF: ${msg.spf_status.toUpperCase()}`;
                document.getElementById('dkimBadge').textContent = `DKIM: ${msg.dkim_status.toUpperCase()}`;
                document.getElementById('dmarcBadge').textContent = `DMARC: ${msg.dmarc_status.toUpperCase()}`;

                const attArea = document.getElementById('attachmentArea');
                const attList = document.getElementById('attachmentList');
                attList.innerHTML = '';
                if (content.attachments && content.attachments.length > 0) {
                    attArea.classList.remove('d-none');
                    content.attachments.forEach(att => {
                        const card = document.createElement('div');
                        card.className = 'badge bg-light text-dark border p-2 d-flex align-items-center';
                        card.innerHTML = `<i class="bi bi-file-earmark-arrow-down me-2 fs-6"></i> ${att.file_name} (${(att.size / 1024).toFixed(1)} KB)`;
                        attList.appendChild(card);
                    });
                } else {
                    attArea.classList.add('d-none');
                }

                const htmlFrame = document.getElementById('htmlContentFrame');
                const textContainer = document.getElementById('textContentContainer');

                if (content.body_html) {
                    textContainer.classList.add('d-none');
                    htmlFrame.classList.remove('d-none');
                    htmlFrame.srcdoc = content.body_html;
                } else {
                    htmlFrame.classList.add('d-none');
                    textContainer.classList.remove('d-none');
                    textContainer.textContent = content.body_text || msg.snippet;
                }
            } catch (err) {
                alert('Gagal mengambil konten email: ' + err.message);
            }
        }

        async function toggleStar(e, id) {
            e.stopPropagation();
            try {
                const res = await fetch(`/api/v1/webmail/messages/${id}/star`, { method: 'POST' });
                const data = await res.json();
                const starBtn = document.getElementById(`star-btn-${id}`);
                if (data.is_flagged) {
                    starBtn.innerHTML = '<i class="bi bi-star-fill text-warning"></i>';
                } else {
                    starBtn.innerHTML = '<i class="bi bi-star"></i>';
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function moveCurrentMail(targetBox) {
            if (!currentLoadedMailId) return;
            if (!confirm(`Pindahkan email ini ke ${targetBox}?`)) return;

            try {
                const res = await fetch('/api/v1/webmail/messages/move', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message_id: currentLoadedMailId, target_mailbox: targetBox })
                });
                if (res.ok) {
                    document.getElementById(`msg-item-${currentLoadedMailId}`)?.remove();
                    document.getElementById('readerEmptyState').classList.remove('d-none');
                    document.getElementById('readerContainer').classList.add('d-none');
                    currentLoadedMailId = null;
                }
            } catch (err) {
                alert('Gagal memindahkan pesan');
            }
        }

        function filterMessages() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('.mail-item').forEach(item => {
                const text = item.textContent.toLowerCase();
                item.style.display = text.includes(query) ? '' : 'none';
            });
        }

        function replyCurrentMail() {
            const from = document.getElementById('readMailFrom').textContent;
            const subject = document.getElementById('readMailSubject').textContent;
            const reSubject = subject.startsWith('Re:') ? subject : `Re: ${subject}`;
            openComposer(from, reSubject, `<br><br><blockquote>--- Pesan Asli dari ${from} ---<br></blockquote>`);
        }

        function forwardCurrentMail() {
            const subject = document.getElementById('readMailSubject').textContent;
            const fwdSubject = subject.startsWith('Fwd:') ? subject : `Fwd: ${subject}`;
            openComposer('', fwdSubject, `<br><br><blockquote>--- Pesan Diteruskan ---<br></blockquote>`);
        }

        // Live Real-Time SSE Listener
        const sseSource = new EventSource('/api/v1/sse');
        sseSource.onmessage = function(event) {
            try {
                const data = JSON.parse(event.data);
                if (data.type === 'new_email') {
                    const badge = document.getElementById('inboxCountBadge');
                    if (badge) {
                        badge.textContent = parseInt(badge.textContent || 0) + 1;
                    }
                }
            } catch (err) {
                console.error(err);
            }
        };
    </script>
</body>
</html>
