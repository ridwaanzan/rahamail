        async function submitEnable2FA() {
            const secret = document.getElementById('twoFASecretInput').value;
            const code = document.getElementById('twoFAVerifyCode').value.trim();
            const alertBox = document.getElementById('twoFAAlert');

            if (!code || code.length !== 6) {
                alertBox.className = 'p-3 rounded-xl text-xs bg-rose-500/10 text-rose-500 border border-rose-500/20';
                alertBox.textContent = 'Masukkan 6 digit kode dari aplikasi Authenticator';
                alertBox.classList.remove('hidden');
                return;
            }

            try {
                const res = await fetch('/api/v1/2fa/enable', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ secret, code })
                });
                const data = await res.json();
                if (res.ok && data.status === 'success') {
                    alertBox.className = 'p-3 rounded-xl text-xs bg-emerald-500/10 text-emerald-500 border border-emerald-500/20';
                    alertBox.textContent = data.message;
                    alertBox.classList.remove('hidden');

                    document.getElementById('setup2FASteps').classList.add('hidden');
                    const backupContainer = document.getElementById('backupCodesDisplay');
                    const backupList = document.getElementById('backupCodesList');
                    backupList.innerHTML = '';
                    if (data.backup_codes) {
                        data.backup_codes.forEach(c => {
                            const col = document.createElement('div');
                            col.className = 'text-center p-1 rounded bg-slate-100 dark:bg-dark-header';
                            col.textContent = c;
                            backupList.appendChild(col);
                        });
                        backupContainer.classList.remove('hidden');
                    }
                    setTimeout(() => { location.reload(); }, 3500);
                } else {
                    alertBox.className = 'p-3 rounded-xl text-xs bg-rose-500/10 text-rose-500 border border-rose-500/20';
                    alertBox.textContent = data.error || 'Verifikasi kode gagal';
                    alertBox.classList.remove('hidden');
                }
            } catch (err) {
                alert('Gagal terhubung ke server');
            }
        }

