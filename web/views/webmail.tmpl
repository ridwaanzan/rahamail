        // Contact Auto-Complete for Composer
        function handleContactAutoComplete(input, targetSugId) {
            clearTimeout(autoHarvestTimeout);
            const val = input.value;
            const container = document.getElementById(targetSugId);
            const lastToken = val.split(',').pop().trim();

            if (!lastToken || lastToken.length < 1) {
                container.classList.add('d-none');
                container.innerHTML = '';
                return;
            }

            autoHarvestTimeout = setTimeout(async () => {
                try {
                    const res = await fetch('/api/v1/webmail/contacts?q=' + encodeURIComponent(lastToken));
                    const data = await res.json();
                    if (res.ok && Array.isArray(data) && data.length > 0) {
                        container.innerHTML = data.slice(0, 5).map(c => `
                            <button type="button" class="list-group-item list-group-item-action py-1 px-2 d-flex justify-content-between align-items-center" onclick="selectAutoCompleteContact('${input.id}', '${targetSugId}', '${c.email}')">
                                <div>
                                    <div class="small fw-semibold text-dark">${escapeHtml(c.name)}</div>
                                    <div class="text-secondary" style="font-size:0.75rem;">${escapeHtml(c.email)}</div>
                                </div>
                                <span class="badge bg-light text-secondary border small">Kontak</span>
                            </button>
                        `).join('');
                        container.classList.remove('d-none');
                    } else {
                        container.classList.add('d-none');
                    }
                } catch (e) {
                    container.classList.add('d-none');
                }
            }, 150);
        }

        function selectAutoCompleteContact(inputId, targetSugId, email) {
            const input = document.getElementById(inputId);
            const parts = input.value.split(',');
            parts.pop();
            parts.push(' ' + email);
            input.value = parts.join(',').trim();
            if (input.value.startsWith(',')) input.value = input.value.substring(1).trim();
            document.getElementById(targetSugId).classList.add('d-none');
            input.focus();
        }

        // Vacation Auto-Responder
        function openAutoResponderModal() {
            if (!autoResponderModalInstance) {
                autoResponderModalInstance = new bootstrap.Modal(document.getElementById('autoResponderModal'));
            }
            loadAutoResponderData();
            autoResponderModalInstance.show();
        }

        async function loadAutoResponderData() {
            try {
                const res = await fetch('/api/v1/webmail/auto-responder');
                const data = await res.json();
                if (res.ok && data) {
                    document.getElementById('arEnabled').checked = data.enabled;
                    document.getElementById('arSubject').value = data.subject || '';
                    document.getElementById('arBodyText').value = data.body_text || '';
                    if (data.start_time) {
                        document.getElementById('arStartTime').value = new Date(data.start_time).toISOString().slice(0, 16);
                    }
                    if (data.end_time) {
                        document.getElementById('arEndTime').value = new Date(data.end_time).toISOString().slice(0, 16);
                    }
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function submitSaveAutoResponder() {
            const enabled = document.getElementById('arEnabled').checked;
            const subject = document.getElementById('arSubject').value.trim();
            const body_text = document.getElementById('arBodyText').value;
            const startVal = document.getElementById('arStartTime').value;
            const endVal = document.getElementById('arEndTime').value;

            const payload = {
                enabled,
                subject,
                body_text,
                start_time: startVal ? new Date(startVal).toISOString() : null,
                end_time: endVal ? new Date(endVal).toISOString() : null
            };

            try {
                const res = await fetch('/api/v1/webmail/auto-responder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (res.ok) {
                    alert('Pengaturan balasan liburan otomatis berhasil disimpan.');
                    autoResponderModalInstance.hide();
                } else {
                    alert(data.error || 'Gagal menyimpan.');
                }
            } catch (err) {
                alert('Gagal terhubung ke server.');
            }
        }

        // Canned Responses / Templates
        async function loadTemplatesDropdown() {
            const menu = document.getElementById('cannedTemplatesDropdown');
            try {
                const res = await fetch('/api/v1/webmail/templates');
                const data = await res.json();
                if (res.ok && Array.isArray(data)) {
                    if (data.length === 0) {
                        menu.innerHTML = `
                            <li><span class="dropdown-item-text text-muted small">Belum ada template</span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item small text-primary" href="javascript:void(0)" onclick="openCannedModal()"><i class="bi bi-gear me-1"></i>Kelola Template</a></li>
                        `;
                        return;
                    }
                    menu.innerHTML = data.map(t => `
                        <li><a class="dropdown-item small" href="javascript:void(0)" onclick="insertCannedTemplate('${escapeHtml(t.content).replace(/'/g, "\\'")}')">${escapeHtml(t.title)}</a></li>
                    `).join('') + `
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item small text-primary" href="javascript:void(0)" onclick="openCannedModal()"><i class="bi bi-gear me-1"></i>Kelola Template</a></li>
                    `;
                }
            } catch (err) {
                menu.innerHTML = '<li><span class="dropdown-item-text text-danger small">Gagal memuat</span></li>';
            }
        }

        function insertCannedTemplate(content) {
            const editor = document.getElementById('composeEditor');
            editor.innerHTML += '<p>' + content.replace(/\n/g, '<br>') + '</p>';
            triggerAutoSave();
        }

        function openCannedModal() {
            if (!cannedModalInstance) {
                cannedModalInstance = new bootstrap.Modal(document.getElementById('cannedModal'));
            }
            loadCannedList();
            cannedModalInstance.show();
        }

        async function loadCannedList() {
            const list = document.getElementById('cannedModalList');
            try {
                const res = await fetch('/api/v1/webmail/templates');
                const data = await res.json();
                if (res.ok && Array.isArray(data)) {
                    if (data.length === 0) {
                        list.innerHTML = '<div class="list-group-item text-center text-muted small py-3">Belum ada template dibuat.</div>';
                        return;
                    }
                    list.innerHTML = data.map(t => `
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1 small text-dark">${escapeHtml(t.title)}</h6>
                                <p class="small text-secondary mb-0 text-truncate" style="max-width: 480px;">${escapeHtml(t.content)}</p>
                            </div>
                            <button class="btn btn-xs btn-outline-danger py-0 px-2" onclick="deleteCannedItem(${t.id})"><i class="bi bi-trash"></i></button>
                        </div>
                    `).join('');
                }
            } catch (err) {
                list.innerHTML = '<div class="list-group-item text-center text-danger small py-3">Gagal memuat.</div>';
            }
        }

        async function submitCreateTemplate() {
            const title = document.getElementById('newTemplateTitle').value.trim();
            const content = document.getElementById('newTemplateContent').value.trim();
            if (!title || !content) {
                alert('Judul dan isi template wajib diisi.');
                return;
            }

            try {
                const res = await fetch('/api/v1/webmail/templates', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, content })
                });
                const data = await res.json();
                if (res.ok) {
                    document.getElementById('newTemplateTitle').value = '';
                    document.getElementById('newTemplateContent').value = '';
                    loadCannedList();
                } else {
                    alert(data.error || 'Gagal menyimpan template.');
                }
            } catch (err) {
                alert('Gagal terhubung ke server.');
            }
        }

        async function deleteCannedItem(id) {
            if (!confirm('Hapus template ini?')) return;
            try {
                const res = await fetch(`/api/v1/webmail/templates/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    loadCannedList();
                } else {
                    alert('Gagal menghapus template.');
                }
            } catch (err) {
                alert('Gagal terhubung ke server.');
            }
        }

        // Live Real-Time SSE Listener
        const sseSource = new EventSource('/api/v1/sse');
        sseSource.onmessage = function(event) {
            try {
                const data = JSON.parse(event.data);
                if (data.type === 'new_email') {
                    const badge = document.getElementById('inboxCountBadge');
                    if (badge) {
                        badge.textContent = parseInt(badge.textContent || 0) + 1;
                    }
                }
            } catch (err) {
                console.error(err);
            }
        };
    </script>
</body>
</html>
