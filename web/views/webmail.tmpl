    <!-- SCRIPT LOGIC (NATIVE JS MODALS & WEBSOCKET/SSE/API INTERFACE) -->
    <script>
        let currentLoadedMailId = null;
        let selectedAttachments = [];
        let currentMailAttachments = [];
        let currentSecurityAlert = null;
        let isScheduleMode = false;
        let autoSaveTimer = null;

        // Theme Toggle
        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        // Mobile Sidebar
        function toggleMobileSidebar() {
            const sb = document.getElementById('sidebarFolders');
            if (sb) {
                sb.classList.toggle('-translate-x-full');
            }
        }

        // Native Modal Helpers
        function showModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.remove('hidden');
        }
        function hideModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('hidden');
        }

        function openComposer(to = '', subject = '', body = '') {
            selectedAttachments = [];
            isScheduleMode = false;
            document.getElementById('scheduleTimeBox').classList.add('hidden');
            document.getElementById('btnSendMail').innerHTML = '<i class="bi bi-send-fill text-xs"></i><span>Kirim Sekarang</span>';

            if (to || subject || body) {
                document.getElementById('composeTo').value = to;
                document.getElementById('composeSubject').value = subject;
                document.getElementById('composeEditor').innerHTML = body;
                document.getElementById('composeCc').value = '';
                document.getElementById('composeBcc').value = '';
            } else {
                restoreDraftFromStorage();
            }

            renderAttachmentChips();
            showModal('composerModal');
        }

        function closeComposer() {
            hideModal('composerModal');
        }

        function closeAttachmentPreviewModal() {
            hideModal('attachmentPreviewModal');
        }

        function openSecuritySettingsModal() {
            showModal('securitySettingsModal');
        }
        function closeSecuritySettingsModal() {
            hideModal('securitySettingsModal');
        }

        function switchSecurityTab(tab) {
            const btn2fa = document.getElementById('tab2faBtn');
            const btnApi = document.getElementById('tabApiKeysBtn');
            const sec2fa = document.getElementById('secTab2fa');
            const secApi = document.getElementById('secTabApiKeys');

            if (tab === '2fa') {
                btn2fa.className = 'pb-2 text-xs font-semibold border-b-2 border-cyan-500 text-cyan-600 dark:text-cyan-400';
                btnApi.className = 'pb-2 text-xs font-medium text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white';
                sec2fa.classList.remove('hidden');
                secApi.classList.add('hidden');
            } else {
                btnApi.className = 'pb-2 text-xs font-semibold border-b-2 border-cyan-500 text-cyan-600 dark:text-cyan-400';
                btn2fa.className = 'pb-2 text-xs font-medium text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white';
                secApi.classList.remove('hidden');
                sec2fa.classList.add('hidden');
                loadAPIKeys();
            }
        }

        function openContactsModal() {
            showModal('contactsModal');
            loadContactsList();
        }
        function closeContactsModal() {
            hideModal('contactsModal');
        }

        function openAutoResponderModal() {
            showModal('autoResponderModal');
            loadAutoResponderData();
        }
        function closeAutoResponderModal() {
            hideModal('autoResponderModal');
        }

        function openCannedModal() {
            showModal('cannedModal');
            loadCannedList();
        }
        function closeCannedModal() {
            hideModal('cannedModal');
        }

        function toggleTemplatesDropdown() {
            const drop = document.getElementById('cannedDropdownMenu');
            drop.classList.toggle('hidden');
            if (!drop.classList.contains('hidden')) {
                loadTemplatesDropdown();
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const inputs = ['composeTo', 'composeCc', 'composeBcc', 'composeSubject'];
            inputs.forEach(id => {
                document.getElementById(id)?.addEventListener('input', triggerAutoSave);
            });
            document.getElementById('composeEditor')?.addEventListener('input', triggerAutoSave);

            // Close dropdowns on outside click
            document.addEventListener('click', (e) => {
                const drop = document.getElementById('cannedDropdownMenu');
                if (drop && !drop.contains(e.target) && !e.target.closest('button[onclick="toggleTemplatesDropdown()"]')) {
                    drop.classList.add('hidden');
                }
            });
        });

        function triggerAutoSave() {
            clearTimeout(autoSaveTimer);
            const statusEl = document.getElementById('draftSaveStatus');
            if (statusEl) {
                statusEl.innerHTML = '<span class="animate-spin mr-1">⌛</span> Menyimpan draf...';
            }
            autoSaveTimer = setTimeout(saveDraftToStorage, 1000);
        }

        function saveDraftToStorage() {
            const draftData = {
                to: document.getElementById('composeTo').value,
                cc: document.getElementById('composeCc').value,
                bcc: document.getElementById('composeBcc').value,
                subject: document.getElementById('composeSubject').value,
                body: document.getElementById('composeEditor').innerHTML,
                updatedAt: new Date().toLocaleTimeString()
            };
            localStorage.setItem('rahamail_draft', JSON.stringify(draftData));
            const statusEl = document.getElementById('draftSaveStatus');
            if (statusEl) {
                statusEl.innerHTML = `<i class="bi bi-cloud-check text-emerald-500 mr-1"></i> Tersimpan lokal (${draftData.updatedAt})`;
            }
        }

        function restoreDraftFromStorage() {
            const saved = localStorage.getItem('rahamail_draft');
            if (!saved) return false;
            try {
                const data = JSON.parse(saved);
                if (data.to || data.subject || (data.body && data.body.trim() !== '')) {
                    document.getElementById('composeTo').value = data.to || '';
                    document.getElementById('composeCc').value = data.cc || '';
                    document.getElementById('composeBcc').value = data.bcc || '';
                    document.getElementById('composeSubject').value = data.subject || '';
                    document.getElementById('composeEditor').innerHTML = data.body || '';
                    if (data.cc || data.bcc) {
                        document.getElementById('ccBccContainer').classList.remove('hidden');
                    }
                    const statusEl = document.getElementById('draftSaveStatus');
                    if (statusEl) {
                        statusEl.innerHTML = `<i class="bi bi-cloud-check text-emerald-500 mr-1"></i> Draf dipulihkan (${data.updatedAt || 'sebelumnya'})`;
                    }
                    return true;
                }
            } catch (err) {
                console.error(err);
            }
            return false;
        }

        function clearDraft() {
            localStorage.removeItem('rahamail_draft');
            document.getElementById('composeTo').value = '';
            document.getElementById('composeCc').value = '';
            document.getElementById('composeBcc').value = '';
            document.getElementById('composeSubject').value = '';
            document.getElementById('composeEditor').innerHTML = '';
            const statusEl = document.getElementById('draftSaveStatus');
            if (statusEl) {
                statusEl.innerHTML = '<i class="bi bi-check mr-1"></i> Draf dibersihkan';
            }
        }

        function toggleCcBcc() {
            const container = document.getElementById('ccBccContainer');
            container.classList.toggle('hidden');
        }

        function toggleScheduleBox() {
            const box = document.getElementById('scheduleTimeBox');
            const btn = document.getElementById('btnSendMail');
            isScheduleMode = !isScheduleMode;

            if (isScheduleMode) {
                box.classList.remove('hidden');
                btn.innerHTML = '<i class="bi bi-clock-history mr-1"></i><span>Jadwalkan Pengiriman</span>';
                const tomorrow = new Date();
                tomorrow.setDate(tomorrow.getDate() + 1);
                tomorrow.setHours(8, 0, 0, 0);
                const isoStr = new Date(tomorrow.getTime() - tomorrow.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
                document.getElementById('scheduleDatetimeInput').value = isoStr;
            } else {
                box.classList.add('hidden');
                btn.innerHTML = '<i class="bi bi-send-fill text-xs"></i><span>Kirim Sekarang</span>';
            }
        }

        function formatDoc(cmd, val = null) {
            document.execCommand(cmd, false, val);
            document.getElementById('composeEditor').focus();
        }

        function insertLinkPrompt() {
            const url = prompt('Masukkan URL tautan:');
            if (url) formatDoc('createLink', url);
        }

        function handleFileSelect(event) {
            const files = event.target.files;
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                if (file.size > 15 * 1024 * 1024) {
                    alert(`File ${file.name} melebihi batas 15MB.`);
                    continue;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    selectedAttachments.push({
                        file_name: file.name,
                        content_type: file.type || 'application/octet-stream',
                        size: file.size,
                        data_base64: e.target.result
                    });
                    renderAttachmentChips();
                };
                reader.readAsDataURL(file);
            }
            event.target.value = '';
        }

        function renderAttachmentChips() {
            const container = document.getElementById('composerAttachments');
            container.innerHTML = '';
            selectedAttachments.forEach((att, idx) => {
                const chip = document.createElement('div');
                chip.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs bg-slate-100 dark:bg-dark-header border border-light-border dark:border-dark-border text-light-text dark:text-white';
                chip.innerHTML = `
                    <i class="bi bi-paperclip text-cyan-500"></i>
                    <span>${att.file_name} (${(att.size / 1024).toFixed(0)} KB)</span>
                    <button type="button" onclick="removeAttachment(${idx})" class="text-rose-500 hover:text-rose-400 p-0.5"><i class="bi bi-x-circle"></i></button>
                `;
                container.appendChild(chip);
            });
        }

        function removeAttachment(idx) {
            selectedAttachments.splice(idx, 1);
            renderAttachmentChips();
        }

        async function submitSendOrScheduleEmail() {
            const to = document.getElementById('composeTo').value.trim();
            const subject = document.getElementById('composeSubject').value.trim();
            const bodyHTML = document.getElementById('composeEditor').innerHTML;
            const bodyText = document.getElementById('composeEditor').innerText;
            const cc = document.getElementById('composeCc').value.trim();
            const bcc = document.getElementById('composeBcc').value.trim();
            const btn = document.getElementById('btnSendMail');

            if (!to) {
                alert('Silakan masukkan alamat penerima email (To).');
                return;
            }
            if (!subject) {
                alert('Silakan masukkan subjek email.');
                return;
            }

            btn.disabled = true;

            if (isScheduleMode) {
                const schedVal = document.getElementById('scheduleDatetimeInput').value;
                if (!schedVal) {
                    alert('Pilih tanggal dan jam pengiriman.');
                    btn.disabled = false;
                    return;
                }
                btn.innerHTML = '<span>Menjadwalkan...</span>';

                try {
                    const res = await fetch('/api/v1/webmail/schedule', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            to, cc, bcc, subject,
                            body_html: bodyHTML,
                            body_text: bodyText,
                            scheduled_at: schedVal
                        })
                    });
                    const data = await res.json();
                    if (res.ok && data.status === 'success') {
                        localStorage.removeItem('rahamail_draft');
                        alert(data.message);
                        closeComposer();
                        window.location.href = '/mail?folder=Scheduled';
                    } else {
                        alert('Gagal menjadwalkan: ' + (data.error || 'Terjadi kesalahan'));
                    }
                } catch (err) {
                    alert('Gagal menghubungi server.');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-clock-history mr-1"></i><span>Jadwalkan Pengiriman</span>';
                }
            } else {
                btn.innerHTML = '<span>Mengirim...</span>';

                try {
                    const res = await fetch('/api/v1/webmail/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            to, cc, bcc, subject,
                            body_html: bodyHTML,
                            body_text: bodyText,
                            attachments: selectedAttachments
                        })
                    });

                    const data = await res.json();
                    if (res.ok && data.status === 'success') {
                        localStorage.removeItem('rahamail_draft');
                        alert('Email berhasil dikirim!');
                        closeComposer();
                        location.reload();
                    } else {
                        alert('Gagal mengirim email: ' + (data.error || 'Terjadi kesalahan'));
                    }
                } catch (err) {
                    alert('Gagal terhubung ke server saat mengirim email.');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-send-fill text-xs"></i><span>Kirim Sekarang</span>';
                }
            }
        }

