        async function loadMessageDetail(id) {
            currentLoadedMailId = id;

            document.querySelectorAll('.mail-item').forEach(el => {
                el.classList.remove('bg-cyan-500/10', 'border-l-4', 'border-cyan-500');
            });
            const activeItem = document.getElementById(`msg-item-${id}`);
            if (activeItem) {
                activeItem.classList.add('bg-cyan-500/10', 'border-l-4', 'border-cyan-500');
            }

            try {
                const res = await fetch(`/api/v1/webmail/messages/${id}`);
                if (!res.ok) throw new Error('Gagal memuat pesan');
                const data = await res.json();

                document.getElementById('readerEmptyState').classList.add('hidden');
                document.getElementById('readerContainer').classList.remove('hidden');

                const msg = data.message;
                const content = data.content;

                document.getElementById('readMailSubject').textContent = msg.subject || '(Tanpa Subjek)';
                document.getElementById('readMailFrom').textContent = msg.from;
                document.getElementById('readMailTo').textContent = msg.to;
                document.getElementById('readMailDate').textContent = new Date(msg.received_at).toLocaleString();

                document.getElementById('spfBadge').textContent = `SPF: ${msg.spf_status.toUpperCase()}`;
                document.getElementById('dkimBadge').textContent = `DKIM: ${msg.dkim_status.toUpperCase()}`;
                document.getElementById('dmarcBadge').textContent = `DMARC: ${msg.dmarc_status.toUpperCase()}`;

                const attArea = document.getElementById('attachmentArea');
                const attList = document.getElementById('attachmentList');
                attList.innerHTML = '';
                if (content.attachments && content.attachments.length > 0) {
                    attArea.classList.remove('hidden');
                    content.attachments.forEach((att, idx) => {
                        const chip = document.createElement('div');
                        chip.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20';
                        const sizeKB = (att.size / 1024).toFixed(1);
                        chip.innerHTML = `
                            <button type="button" onclick="previewAttachment(${idx})" class="font-medium hover:underline flex items-center gap-1">
                                <i class="bi bi-eye"></i> ${att.file_name} (${sizeKB} KB)
                            </button>
                            <button type="button" onclick="downloadAttachment(${idx})" class="p-0.5 hover:text-white" title="Unduh">
                                <i class="bi bi-download"></i>
                            </button>
                        `;
                        attList.appendChild(chip);
                    });
                    currentMailAttachments = content.attachments;
                } else {
                    attArea.classList.add('hidden');
                    currentMailAttachments = [];
                }

                currentSecurityAlert = data.security_alert || null;
                renderSecurityBanner(currentSecurityAlert);

                const htmlFrame = document.getElementById('htmlContentFrame');
                const textContainer = document.getElementById('textContentContainer');

                if (content.body_html) {
                    textContainer.classList.add('hidden');
                    htmlFrame.classList.remove('hidden');
                    htmlFrame.srcdoc = content.body_html;
                } else {
                    htmlFrame.classList.add('hidden');
                    textContainer.classList.remove('hidden');
                    textContainer.textContent = content.body_text || msg.snippet;
                }
            } catch (err) {
                alert('Gagal mengambil konten email: ' + err.message);
            }
        }

