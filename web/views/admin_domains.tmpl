<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .title }}</title>
    <!-- Compiled TailwindCSS Dark & Light Mode Theme -->
    <link rel="stylesheet" href="/static/css/app.min.css">
    <!-- Embedded Base64 Bootstrap Icons -->
    <link rel="stylesheet" href="/static/css/bootstrap-icons.min.css">
    <script>
        if (localStorage.getItem('theme') === 'light' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: light)').matches)) {
            document.documentElement.classList.remove('dark');
        } else {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body class="bg-light-bg dark:bg-dark-bg text-light-text dark:text-dark-text min-h-screen flex flex-col md:flex-row antialiased selection:bg-cyan-500 selection:text-white">

    <!-- SIDEBAR NAVIGATION -->
    <aside class="w-full md:w-64 bg-light-sidebar dark:bg-dark-sidebar border-r border-light-border dark:border-dark-border flex flex-col justify-between shrink-0 min-h-screen p-4">
        <div>
            <!-- Brand / Logo Header -->
            <div class="flex items-center justify-between px-2 mb-8">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-cyan-glow">
                        <i class="bi bi-envelope-paper-heart-fill text-lg"></i>
                    </div>
                    <div>
                        <h1 class="text-base font-bold tracking-tight text-light-text dark:text-white">Corporate</h1>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-cyan-500/10 text-cyan-500 dark:text-cyan-400 border border-cyan-500/20">
                            {{ .db_driver }}
                        </span>
                    </div>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="px-2 mb-2">
                <span class="text-[11px] font-semibold tracking-wider uppercase text-light-muted dark:text-dark-muted">Admin Menu</span>
            </div>
            <nav class="space-y-1.5">
                <a href="/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-grid-fill text-base"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/domains" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 shadow-sm">
                    <i class="bi bi-globe text-base"></i>
                    <span>Domain Management</span>
                </a>
                <a href="/mail" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-inbox-fill text-base"></i>
                    <span>User Webmail</span>
                    <span class="ml-auto text-[10px] px-1.5 py-0.5 rounded-full bg-blue-500/10 text-blue-500 dark:text-blue-400 font-semibold border border-blue-500/20">Open</span>
                </a>
                <a href="/admin/simulations" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-shield-exclamation text-base"></i>
                    <span>Spam & Phishing</span>
                </a>
                <a href="/admin/logs" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-broadcast text-base"></i>
                    <span>Mail Server SSE Live</span>
                </a>
                <a href="/admin/settings" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-dark-card">
                    <i class="bi bi-gear-fill text-base"></i>
                    <span>Settings & Backup</span>
                </a>
            </nav>
        </div>

        <div class="mt-8 pt-4 border-t border-light-border dark:border-dark-border px-2">
            <div class="p-3 rounded-xl bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border text-center">
                <div class="flex items-center justify-center gap-2 text-xs font-semibold text-light-muted dark:text-dark-muted">
                    <i class="bi bi-cpu-fill text-cyan-500"></i>
                    <span>Powered by Golang / SSE</span>
                </div>
                <div class="mt-1 text-[11px] text-slate-400">Zero Node.js Runtime</div>
            </div>
        </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
        <!-- TOPBAR -->
        <header class="h-16 bg-light-header dark:bg-dark-header border-b border-light-border dark:border-dark-border px-6 flex items-center justify-between shrink-0 sticky top-0 z-30">
            <div>
                <h2 class="text-base font-bold text-light-text dark:text-white">Domain Management & DKIM</h2>
            </div>
            <div class="flex items-center gap-3.5">
                <button onclick="toggleTheme()" class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-dark-card border border-light-border dark:border-dark-border text-light-muted dark:text-dark-muted hover:text-cyan-500 transition-colors" title="Toggle Dark/Light Mode">
                    <i class="bi bi-moon-stars-fill text-sm hidden dark:inline"></i>
                    <i class="bi bi-sun-fill text-sm inline dark:hidden text-amber-500"></i>
                </button>
                <div class="flex items-center gap-2.5 pl-2 border-l border-light-border dark:border-dark-border">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white text-xs font-bold">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="hidden sm:block text-left">
                        <div class="text-xs font-bold text-light-text dark:text-white truncate max-w-[140px]">{{ if .currentUser }}{{ .currentUser.Email }}{{ else }}Super Admin{{ end }}</div>
                        <div class="text-[10px] text-cyan-600 dark:text-cyan-400 font-medium">Super Administrator</div>
                    </div>
                    <a href="/logout" class="ml-1 p-2 rounded-xl text-light-muted dark:text-dark-muted hover:text-rose-500 dark:hover:text-rose-400 hover:bg-rose-500/10 transition-colors" title="Keluar / Logout">
                        <i class="bi bi-box-arrow-right text-base"></i>
                    </a>
                </div>
            </div>
        </header>

        <!-- CONTENT -->
        <div class="p-6 space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-bold tracking-tight text-light-text dark:text-white">Domain Management & DKIM Key Specs</h3>
                    <p class="text-xs text-light-muted dark:text-dark-muted">Konfigurasi nama domain email terlayani dan verifikasi kunci kriptografi RSA 2048-bit.</p>
                </div>
                <button onclick="openAddDomainModal()" class="px-4 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white transition-all flex items-center gap-1.5 shadow-cyan-glow">
                    <i class="bi bi-plus-lg"></i> Tambah Domain
                </button>
            </div>

            <div class="p-5 rounded-2xl bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border shadow-card-light dark:shadow-card-dark overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="text-[11px] uppercase tracking-wider text-light-muted dark:text-dark-muted border-b border-light-border dark:border-dark-border">
                        <tr>
                            <th class="py-3 px-4 font-semibold">Nama Domain</th>
                            <th class="py-3 px-4 font-semibold">DKIM Selector</th>
                            <th class="py-3 px-4 font-semibold">Key Spec</th>
                            <th class="py-3 px-4 font-semibold">Status</th>
                            <th class="py-3 px-4 font-semibold text-right">Tindakan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-light-border dark:divide-dark-border">
                        {{ range .domains }}
                        <tr class="hover:bg-slate-50 dark:hover:bg-dark-cardHover transition-colors">
                            <td class="py-3.5 px-4 font-bold text-light-text dark:text-white">{{ .Name }}</td>
                            <td class="py-3.5 px-4 font-mono text-cyan-600 dark:text-cyan-400">{{ .DKIMSelector }}</td>
                            <td class="py-3.5 px-4 text-slate-500 dark:text-dark-muted">RSA 2048-bit</td>
                            <td class="py-3.5 px-4">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">ACTIVE</span>
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <button onclick="showDkimModal('{{ .Name }}', '{{ .DKIMSelector }}', '{{ .DKIMPublicKey }}')" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-dark-bg border border-light-border dark:border-dark-border hover:border-cyan-500 text-light-text dark:text-slate-200 transition-colors">
                                    <i class="bi bi-shield-lock text-cyan-500 me-1"></i> DNS TXT
                                </button>
                            </td>
                        </tr>
                        {{ else }}
                        <tr>
                            <td colspan="5" class="py-8 text-center text-slate-400">Belum ada domain terdaftar.</td>
                        </tr>
                        {{ end }}
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- MODAL TAMBAH DOMAIN -->
    <div id="modalAddDomain" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-light-card dark:bg-dark-card border border-light-border dark:border-dark-border rounded-2xl w-full max-w-md shadow-card-dark overflow-hidden flex flex-col">
            <div class="px-4 py-3 border-b border-light-border dark:border-dark-border flex items-center justify-between bg-light-header dark:bg-dark-header">
                <h3 class="text-sm font-bold text-light-text dark:text-white flex items-center gap-2">
                    <i class="bi bi-globe text-cyan-500"></i> Tambah Domain Baru
                </h3>
                <button type="button" onclick="closeAddDomainModal()" class="text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white p-1">
                    <i class="bi bi-x-lg text-sm"></i>
                </button>
            </div>
            <div class="p-4 space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-light-muted dark:text-dark-muted mb-1">NAMA DOMAIN</label>
                    <input type="text" id="newDomainName" placeholder="example.com" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-dark-bg border border-light-border dark:border-dark-border text-light-text dark:text-white focus:outline-none focus:border-cyan-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-light-muted dark:text-dark-muted mb-1">DKIM SELECTOR (OPSIONAL)</label>
                    <input type="text" id="newDomainSelector" placeholder="default" class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-dark-bg border border-light-border dark:border-dark-border text-light-text dark:text-white focus:outline-none focus:border-cyan-500">
                </div>
            </div>
            <div class="px-4 py-3 border-t border-light-border dark:border-dark-border bg-light-header dark:bg-dark-header flex justify-end gap-2">
                <button onclick="closeAddDomainModal()" class="px-3 py-1.5 rounded-xl text-xs font-medium text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white border border-light-border dark:border-dark-border">Batal</button>
                <button onclick="submitCreateDomain()" class="px-4 py-1.5 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 shadow-cyan-glow">Simpan Domain</button>
            </div>
        </div>
    </div>

    <script src="/static/js/app.min.js"></script>
    <script>
        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }
        function openAddDomainModal() {
            document.getElementById('modalAddDomain').classList.remove('hidden');
        }
        function closeAddDomainModal() {
            document.getElementById('modalAddDomain').classList.add('hidden');
        }
        async function submitCreateDomain() {
            const name = document.getElementById('newDomainName').value.trim();
            const selector = document.getElementById('newDomainSelector').value.trim() || 'mail';
            if (!name) {
                showModalAlert({ title: 'Validasi Gagal', message: 'Nama domain wajib diisi.', type: 'warning' });
                return;
            }
            try {
                const res = await fetch('/api/v1/domains', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, dkim_selector: selector })
                });
                const data = await res.json();
                if (res.ok) {
                    closeAddDomainModal();
                    await showModalAlert({ title: 'Berhasil', message: `Domain ${name} berhasil ditambahkan beserta RSA 2048-bit DKIM Key!`, type: 'success' });
                    location.reload();
                } else {
                    showModalAlert({ title: 'Gagal', message: data.error || 'Gagal menambahkan domain.', type: 'error' });
                }
            } catch (err) {
                showModalAlert({ title: 'Kesalahan Jaringan', message: 'Gagal menghubungi server.', type: 'error' });
            }
        }
    </script>
</body>
</html>
