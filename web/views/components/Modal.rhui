<component name="ui:Modal">
  <props>
    <prop name="id" default="modal" />
    <prop name="title" default="" />
    <prop name="icon" default="" />
    <prop name="max_width" default="max-w-lg" />
    <prop name="close_action" default="" />
  </props>

  <div id="{{ id }}" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden transition-opacity">
    <div class="w-full {{ max_width }} rounded-2xl border border-light-border dark:border-dark-border bg-light-card dark:bg-dark-card shadow-2xl p-6 relative">
      <div class="flex items-center justify-between pb-4 border-b border-light-border dark:border-dark-border">
        <h3 class="text-base font-bold text-light-text dark:text-white flex items-center gap-2">
          <if test="icon != ''">
            <i class="{{ icon }}"></i>
          </if>
          <span>{{ title }}</span>
        </h3>
        <button type="button" onclick="{{ close_action }}" class="w-8 h-8 rounded-lg flex items-center justify-center text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>

      <div class="py-4">
        <slot />
      </div>

      <if test="has_slot('footer')">
        <div class="pt-4 border-t border-light-border dark:border-dark-border flex items-center justify-end gap-3">
          <slot:footer />
        </div>
      </if>
    </div>
  </div>
</component>
