<component name="ui:ScheduledItem">
  <props>
    <prop name="item" default="" />
  </props>

  <div class="mail-item p-3 cursor-pointer hover:bg-slate-50 dark:hover:bg-dark-card/60 transition-colors" :data-id="item.ID">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[11px] text-amber-500 font-semibold flex items-center gap-1">
        <i class="bi bi-clock text-[10px]"></i>{{ item.ScheduledAt | dateFormat("02 Jan 15:04") }}
      </span>
      <span class="text-[10px] px-1.5 py-0.2 rounded font-medium bg-amber-500/10 text-amber-500 border border-amber-500/20">
        {{ item.Status }}
      </span>
    </div>
    <h4 class="text-xs font-semibold text-light-text dark:text-white truncate mb-0.5">{{ item.Subject }}</h4>
    <p class="text-[11px] text-light-muted dark:text-dark-muted truncate">Kepada: {{ item.To }}</p>
    <if test="item.Status == 'pending'">
      <div class="mt-2 text-right">
        <button type="button" :data-id="item.ID" onclick="cancelSchedule(this.getAttribute('data-id'))" class="px-2 py-0.5 text-[10px] font-medium text-rose-500 hover:text-white hover:bg-rose-600 border border-rose-500/30 rounded transition-all">
          <i class="bi bi-x-circle mr-1"></i>Batalkan
        </button>
      </div>
    </if>
  </div>
</component>
