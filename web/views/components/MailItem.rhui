<component name="ui:MailItem">
  <props>
    <prop name="msg" default="" />
  </props>

  <div class="mail-item p-3 cursor-pointer hover:bg-slate-50 dark:hover:bg-dark-card/60 transition-colors" :data-id="msg.ID" onclick="loadMessageDetail(this.getAttribute('data-id'))">
    <div class="flex items-center justify-between mb-1">
      <span class="text-xs font-semibold text-light-text dark:text-slate-300 truncate pr-2">
        {{ msg.From }}
      </span>
      <span class="text-[10px] text-light-muted dark:text-dark-muted shrink-0">{{ msg.ReceivedAt | dateFormat("02 Jan 15:04") }}</span>
    </div>
    <h4 class="text-xs font-medium text-slate-700 dark:text-slate-300 truncate mb-1">
      {{ msg.Subject }}
    </h4>
    <p class="text-[11px] text-light-muted dark:text-dark-muted truncate line-clamp-1 mb-2">
      {{ msg.Snippet }}
    </p>
    <div class="flex items-center justify-between pt-1">
      <div class="flex items-center gap-1.5">
        <span class="text-[9px] px-1 py-0.2 rounded font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
          SPF: {{ msg.SPFStatus }}
        </span>
        <span class="text-[9px] px-1 py-0.2 rounded font-mono bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">
          DKIM: {{ msg.DKIMStatus }}
        </span>
      </div>
      <button type="button" :data-id="msg.ID" onclick="toggleStar(event, this.getAttribute('data-id'))" class="text-light-muted dark:text-dark-muted hover:text-amber-400 p-0.5" title="Bintang">
        <if test="msg.IsFlagged">
          <i class="bi bi-star-fill text-amber-400 text-xs"></i>
        </if><else>
          <i class="bi bi-star text-xs"></i>
        </else>
      </button>
    </div>
  </div>
</component>
